@* Reusable Booking Card Component *@
<div class="travel-card" style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
    <span style="font-size:2rem;">@(Type switch { "flight" => "✈️", "hotel" => "🏨", "train" => "🚂", _ => "🎫" })</span>
    <div style="flex:1;min-width:200px;">
        <div style="font-weight:700;">@Title</div>
        <div style="font-size:0.9rem;color:var(--text-secondary);">@Subtitle</div>
        <div style="font-size:0.85rem;color:var(--text-muted);">📅 @Date</div>
        <span class="badge @(Status switch { "Confirmed" => "badge-success", "Pending" => "badge-warning", "Cancelled" => "badge-danger", _ => "badge-info" })">@Status</span>
    </div>
    <div style="text-align:right;">
        <div style="font-size:1.2rem;font-weight:800;color:var(--accent-primary);">Rp @Price.ToString("N0")</div>
        <div style="font-size:0.75rem;color:var(--text-muted);">@Code</div>
        <a href="/eticket/@Type/@Code" style="font-size:0.85rem;margin-top:4px;display:inline-block;">🎫 Lihat E-Ticket →</a>
    </div>
</div>

@code {
    [Parameter] public string Type { get; set; } = "flight";
    [Parameter] public string Code { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public string Date { get; set; } = "";
    [Parameter] public decimal Price { get; set; }
    [Parameter] public string Status { get; set; } = "Confirmed";
}
