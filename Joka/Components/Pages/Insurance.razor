@page "/insurance"
@inject AppDbContext DbContext
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Insurance.Title"] — Joka</PageTitle>

<div class="fade-in">
    <div class="page-head">
        <p class="eyebrow">@L["Insurance.Eyebrow"]</p>
        <h1>@L["Insurance.Title"]</h1>
        <p class="lede">@L["Insurance.Lede"]</p>
    </div>

    @if (_plans.Any())
    {
        <div class="grid grid-3">
            @foreach (var plan in _plans)
            {
                <article class="travel-card plan @(plan.Id == _plans[^1].Id ? "plan-top" : "")">
                    <div class="plan-head">
                        <span class="badge badge-quiet">@plan.Coverage</span>
                        <h3>@plan.Name</h3>
                        <p class="muted-line">@L["Insurance.Provider"]: @plan.Provider</p>
                    </div>

                    <p class="clamp-2">@plan.Description</p>

                    <div class="section-title" style="margin-top: var(--s-4);">@L["Insurance.Benefits"]</div>
                    <ul class="benefits">
                        @foreach (var benefit in Benefits(plan.Benefits))
                        {
                            <li>@benefit</li>
                        }
                    </ul>

                    <div class="plan-foot">
                        <Money Amount="@plan.Price" />
                        @* No standalone "buy" here: insurance is attached to a
                           booking at checkout, so a separate purchase would be a
                           dead end. Send people to where it actually applies. *@
                        <p class="micro">@L["Insurance.AddAtCheckout"]</p>
                    </div>
                </article>
            }
        </div>

        <div class="card cta-row">
            <p>@L["Insurance.AddAtCheckout"]</p>
            <a class="btn btn-primary" href="/flights">@L["Home.SearchFlights"]</a>
        </div>
    }
    else
    {
        <div class="empty">
            <h3>@L["Insurance.EmptyTitle"]</h3>
        </div>
    }
</div>

<style>
    .plan { display: flex; flex-direction: column; }

    /* The most protective plan is the one worth pointing at */
    .plan-top { border-color: var(--accent-primary); box-shadow: var(--shadow-md); }

    .plan-head { padding-bottom: var(--s-3); border-bottom: 2px solid var(--border-color); margin-bottom: var(--s-3); }
    .plan-head h3 { margin-top: var(--s-2); }
    .muted-line { font-size: var(--t-sm); color: var(--text-secondary); margin-top: var(--s-1); }

    .clamp-2 {
        font-size: var(--t-sm); color: var(--text-muted);
        display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2;
        -webkit-box-orient: vertical; overflow: hidden;
    }

    .benefits { list-style: none; padding: 0; margin: 0; font-size: var(--t-sm); }
    .benefits li { display: flex; gap: var(--s-2); padding: 3px 0; color: var(--text-secondary); }
    .benefits li::before { content: '✓'; color: var(--accent-success); font-weight: 700; flex: none; }

    .plan-foot { margin-top: auto; padding-top: var(--s-4); border-top: 2px solid var(--border-color); }
    .micro { font-size: var(--t-xs); color: var(--text-muted); margin-top: var(--s-1); }

    .cta-row {
        display: flex; align-items: center; justify-content: space-between;
        gap: var(--s-4); flex-wrap: wrap; margin-top: var(--s-5);
    }
    .cta-row p { color: var(--text-secondary); }
</style>

@code {
    private List<TravelInsurance> _plans = new();

    protected override async Task OnInitializedAsync() =>
        _plans = await DbContext.TravelInsurances.AsNoTracking()
            .Where(i => i.IsActive)
            .OrderBy(i => i.Price)
            .ToListAsync();

    private static IEnumerable<string> Benefits(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return Array.Empty<string>();
        try { return System.Text.Json.JsonSerializer.Deserialize<string[]>(json) ?? Array.Empty<string>(); }
        catch { return Array.Empty<string>(); }
    }
}
