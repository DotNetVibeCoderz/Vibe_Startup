@page "/reset-password"
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Reset.Title"] — Joka</PageTitle>

<div class="fade-in auth-page">
    <div class="card auth-card">
        <div style="text-align:center; margin-bottom: var(--s-5);">
            <div style="font-size:2.5rem;">🔑</div>
            <h1 style="margin-top: var(--s-2);">@L["Reset.Title"]</h1>
            <p style="color: var(--text-secondary); font-size: var(--t-sm);">
                @(_hasToken ? L["Reset.NewPassword"] : L["Reset.Subtitle"])
            </p>
        </div>

        @if (_message is not null)
        {
            <div class="alert @(_isError ? "alert-danger" : "alert-ok")" role="alert">@_message</div>
        }

        @if (!_hasToken)
        {
            @* Step 1: ask for the email that should receive the link. *@
            <div class="field">
                <label for="email">@L["Auth.Email"]</label>
                <input id="email" type="email" @bind="_email" autocomplete="email" placeholder="nama@example.com" />
            </div>

            <button class="btn btn-primary btn-lg btn-block" style="margin-top: var(--s-4);"
                    @onclick="RequestReset" disabled="@_isLoading">
                @(_isLoading ? L["Action.Processing"] : L["Reset.Request"])
            </button>
        }
        else
        {
            @* Step 2: the link carried a token, so collect the new password. *@
            <div class="field">
                <label for="pw">@L["Reset.NewPassword"]</label>
                <input id="pw" type="password" @bind="_newPassword" autocomplete="new-password" placeholder="••••••••" />
            </div>

            <div class="field" style="margin-top: var(--s-3);">
                <label for="confirm">@L["Auth.Password"]</label>
                <input id="confirm" type="password" @bind="_confirmPassword" autocomplete="new-password" placeholder="••••••••" />
            </div>

            <button class="btn btn-primary btn-lg btn-block" style="margin-top: var(--s-4);"
                    @onclick="DoReset" disabled="@_isLoading">
                @(_isLoading ? L["Action.Processing"] : L["Reset.Submit"])
            </button>
        }

        <p style="text-align:center; margin-top: var(--s-5); font-size: var(--t-sm);">
            <a href="/login">@L["Reset.BackToLogin"]</a>
        </p>
    </div>
</div>

<style>
    .auth-page { display: flex; justify-content: center; align-items: center; min-height: 70vh; }
    .auth-card { max-width: 440px; width: 100%; }

    .alert {
        padding: var(--s-3); border-radius: var(--radius-md);
        border: 2px solid currentColor; font-size: var(--t-sm);
        font-weight: 600; margin-bottom: var(--s-4);
        word-break: break-word;
    }
    .alert-danger { color: var(--accent-danger); }
    .alert-ok { color: var(--accent-success); }
</style>

@code {
    [SupplyParameterFromQuery] private string? Token { get; set; }

    private string _email = "", _newPassword = "", _confirmPassword = "", _token = "";
    private string? _message;
    private bool _isLoading, _isError;

    private bool _hasToken => !string.IsNullOrEmpty(_token);

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Token)) _token = Token;
    }

    private async Task RequestReset()
    {
        _isLoading = true;
        _isError = false;
        try
        {
            if (string.IsNullOrWhiteSpace(_email))
            {
                _message = "Email wajib diisi.";
                _isError = true;
                return;
            }

            // Deliberately the same answer whether or not the address exists,
            // so this cannot be used to probe for registered emails.
            var (_, message) = await AuthService.RequestPasswordResetAsync(_email.Trim());
            _message = message;
        }
        finally { _isLoading = false; }
    }

    private async Task DoReset()
    {
        _isLoading = true;
        _isError = false;
        try
        {
            if (_newPassword.Length < 6)
            {
                _message = "Password minimal 6 karakter.";
                _isError = true;
                return;
            }

            if (_newPassword != _confirmPassword)
            {
                _message = "Konfirmasi password tidak cocok.";
                _isError = true;
                return;
            }

            var request = new ChangePasswordRequest
            {
                Token = _token,
                NewPassword = _newPassword,
                ConfirmPassword = _confirmPassword
            };

            var (success, message) = await AuthService.ResetPasswordAsync(request);
            _message = message;
            _isError = !success;

            if (success)
            {
                await Task.Delay(1200);
                Navigation.NavigateTo("/login", true);
            }
        }
        finally { _isLoading = false; }
    }
}
