@page "/admin"
@using Joka.Models.Backoffice
@attribute [Authorize(Policy = "AdminOnly")]
@inject AppDbContext DbContext
@inject HealthProbeService HealthProbe
@inject AnalyticsService Analytics
@inject ReviewService Reviews

<PageTitle>Admin Console — Joka</PageTitle>

<div class="fade-in">
    <div class="console-head">
        <div class="page-head" style="margin:0;">
            <p class="eyebrow">Admin Console</p>
            <h1>Kontrol sistem</h1>
        </div>
        <span class="role-chip">Admin</span>
    </div>

    <div class="tabs">
        @foreach (var t in _tabs)
        {
            <div class="tab-item @(_tab == t.Key ? "active" : "")" role="button" tabindex="0"
                 @onclick="() => _tab = t.Key">@t.Label</div>
        }
    </div>

    @if (_loading)
    {
        <div class="skeleton" style="height:280px;"></div>
    }
    else
    {
        @switch (_tab)
        {
            case "overview":
                <div class="kpi-row">
                    <div class="stat-card"><div class="stat-value">@_txCount</div><div class="stat-label">Transaksi tercatat</div></div>
                    <div class="stat-card"><div class="stat-value">@Rupiah(_txVolume)</div><div class="stat-label">Volume transaksi</div></div>
                    <div class="stat-card"><div class="stat-value">@_users.Count</div><div class="stat-label">Total pengguna</div></div>
                    <div class="stat-card"><div class="stat-value">@_merchants.Count</div><div class="stat-label">Partner terdaftar</div></div>
                    <div class="stat-card"><div class="stat-value">@_openFraud</div><div class="stat-label">Alert fraud terbuka</div></div>
                    <div class="stat-card"><div class="stat-value">@_pendingApprovals</div><div class="stat-label">Approval menunggu</div></div>
                </div>

                <div class="section-title">Analitik</div>
                <div class="chart-grid">
                    <Chart Type="line" Data="@_revenueTrend" Format="currency"
                           Title="Volume pembayaran" Subtitle="14 hari terakhir, transaksi berstatus Completed"
                           Badge="@Rupiah(_revenueTrend.Sum(p => p.Value))" Height="240"
                           EmptyText="Belum ada pembayaran yang selesai" />

                    <Chart Type="donut" Data="@_byMethod" Format="number"
                           Title="Metode pembayaran" Subtitle="Jumlah transaksi per metode"
                           TotalLabel="transaksi" Height="240"
                           EmptyText="Belum ada transaksi" />

                    <Chart Type="hbar" Data="@_byProduct" Format="number"
                           Title="Booking per lini produk" Subtitle="Seluruh tabel booking"
                           Height="240" EmptyText="Belum ada booking" />

                    <Chart Type="bar" Data="@_userGrowth" Format="number"
                           Title="Pengguna baru" Subtitle="6 bulan terakhir"
                           Height="240" EmptyText="Belum ada pendaftaran" />
                </div>

                <div style="display:flex;align-items:center;justify-content:space-between;gap:var(--s-3);flex-wrap:wrap;">
                    <div class="section-title" style="margin:0;">Kesehatan sistem</div>
                    <button class="btn btn-sm btn-ghost" @onclick="RefreshHealth" disabled="@_probing">
                        @(_probing ? "Memeriksa…" : "Periksa ulang")
                    </button>
                </div>
                <div class="table-scroll" style="margin-top:var(--s-3);">
                    <table class="data-table">
                        <thead><tr><th>Komponen</th><th>Status</th><th class="num">Respons</th><th class="num">Uptime</th><th class="num">Error 24j</th><th>Catatan</th></tr></thead>
                        <tbody>
                            @foreach (var h in _health)
                            {
                                <tr>
                                    <td><strong>@h.Component</strong></td>
                                    <td><StatusPill Status="@h.Status" /></td>
                                    <td class="num">@h.ResponseTimeMs ms</td>
                                    <td class="num">@h.UptimePercent.ToString("0.##")%</td>
                                    <td class="num">@h.ErrorCount24h</td>
                                    <td style="color:var(--text-muted);">@h.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                break;

            case "users":
                <p class="hint">Ubah role atau blokir akun. Perubahan langsung tercatat di Audit Log.</p>
                <div class="table-scroll">
                    <table class="data-table">
                        <thead><tr><th>Pengguna</th><th>Email</th><th>Role</th><th>Status</th><th>Tier</th><th>Aksi</th></tr></thead>
                        <tbody>
                            @foreach (var u in _users)
                            {
                                <tr>
                                    <td><strong>@u.FullName</strong><div style="color:var(--text-muted);font-size:var(--t-xs);">@@@u.Username</div></td>
                                    <td class="code" style="font-size:var(--t-xs);">@u.Email</td>
                                    <td>
                                        <select value="@u.Role" @onchange="e => ChangeRole(u, e.Value?.ToString())" style="width:auto;padding:4px 8px;font-size:var(--t-xs);">
                                            @foreach (var r in Roles.All) { <option value="@r">@r</option> }
                                        </select>
                                    </td>
                                    <td><StatusPill Status="@(u.IsBlocked ? "Blocked" : "Active")" /></td>
                                    <td>@u.MembershipTier</td>
                                    <td>
                                        <button class="btn btn-sm @(u.IsBlocked ? "btn-secondary" : "btn-ghost")"
                                                @onclick="() => ToggleBlock(u)">
                                            @(u.IsBlocked ? "Buka blokir" : "Blokir")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                break;

            case "transactions":
                <p class="hint">Monitoring transaksi pembayaran yang tercatat di sistem.</p>
                @if (_transactions.Any())
                {
                    <div class="table-scroll">
                        <table class="data-table">
                            <thead><tr><th>Kode</th><th>Metode</th><th>Status</th><th class="num">Jumlah</th><th>Waktu</th></tr></thead>
                            <tbody>
                                @foreach (var t in _transactions)
                                {
                                    <tr>
                                        <td class="code" style="font-size:var(--t-xs);">@t.TransactionCode</td>
                                        <td>@t.PaymentMethod</td>
                                        <td><StatusPill Status="@t.Status" /></td>
                                        <td class="num">@Rupiah(t.Amount)</td>
                                        <td style="color:var(--text-muted);">@t.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty">
                        <h3>Belum ada transaksi pembayaran</h3>
                        <p>Halaman checkout belum menyimpan PaymentTransaction, jadi tabel ini masih kosong. Lihat Progress.md butir P5-1.</p>
                    </div>
                }
                break;

            case "settlement":
                <p class="hint">Cocokkan nilai internal dengan rekening koran partner. Selisih ditandai otomatis.</p>
                <div class="table-scroll">
                    <table class="data-table">
                        <thead><tr><th>Referensi</th><th>Partner</th><th>Periode</th><th class="num">Transaksi</th><th class="num">Bruto</th><th class="num">Komisi</th><th class="num">Netto</th><th class="num">Selisih</th><th>Status</th><th>Aksi</th></tr></thead>
                        <tbody>
                            @foreach (var s in _settlements)
                            {
                                <tr>
                                    <td class="code" style="font-size:var(--t-xs);">@s.ReferenceNo</td>
                                    <td>@s.Merchant?.Name</td>
                                    <td style="white-space:nowrap;color:var(--text-muted);">@s.PeriodStart.ToString("dd MMM") – @s.PeriodEnd.ToString("dd MMM")</td>
                                    <td class="num">@s.TransactionCount</td>
                                    <td class="num">@Rupiah(s.GrossAmount)</td>
                                    <td class="num">@Rupiah(s.CommissionAmount)</td>
                                    <td class="num"><strong>@Rupiah(s.NetAmount)</strong></td>
                                    <td class="num" style="color:@(s.VarianceAmount != 0 ? "var(--accent-danger)" : "var(--text-muted)");">
                                        @(s.VarianceAmount == 0 ? "—" : Rupiah(s.VarianceAmount))
                                    </td>
                                    <td><StatusPill Status="@s.Status" /></td>
                                    <td>
                                        @if (s.Status is "Reconciled" or "Pending")
                                        {
                                            <button class="btn btn-sm btn-primary" @onclick="() => MarkPaid(s)">Tandai dibayar</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                break;

            case "fraud":
                <p class="hint">Alert dari aturan deteksi. Tinjau lalu tandai aman atau konfirmasi fraud.</p>
                <div class="table-scroll">
                    <table class="data-table">
                        <thead><tr><th>Transaksi</th><th>Akun</th><th>Aturan</th><th>Alasan</th><th class="num">Skor</th><th class="num">Nilai</th><th>Severity</th><th>Status</th><th>Aksi</th></tr></thead>
                        <tbody>
                            @foreach (var f in _fraud)
                            {
                                <tr>
                                    <td class="code" style="font-size:var(--t-xs);">@f.TransactionCode</td>
                                    <td style="font-size:var(--t-xs);">@f.UserEmail</td>
                                    <td><span class="tag">@f.Rule</span></td>
                                    <td style="max-width:260px;color:var(--text-secondary);">@f.Reason</td>
                                    <td class="num"><strong style="color:@RiskColor(f.RiskScore);">@f.RiskScore</strong></td>
                                    <td class="num">@Rupiah(f.Amount)</td>
                                    <td><StatusPill Status="@f.Severity" /></td>
                                    <td><StatusPill Status="@f.Status" /></td>
                                    <td>
                                        @if (f.Status is "Open" or "Reviewing")
                                        {
                                            <div style="display:flex;gap:4px;">
                                                <button class="btn btn-sm btn-ghost" @onclick='() => ResolveFraud(f, "Cleared")'>Aman</button>
                                                <button class="btn btn-sm btn-secondary" @onclick='() => ResolveFraud(f, "Confirmed")'>Fraud</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span style="color:var(--text-muted);font-size:var(--t-xs);">@f.ReviewedBy</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                break;

            case "approvals":
                <p class="hint">Perubahan data master dari merchant menunggu validasi sebelum masuk ke katalog.</p>
                <div class="table-scroll">
                    <table class="data-table">
                        <thead><tr><th>Partner</th><th>Entitas</th><th>Jenis</th><th>Ringkasan</th><th>Diminta oleh</th><th>Status</th><th>Aksi</th></tr></thead>
                        <tbody>
                            @foreach (var a in _approvals)
                            {
                                <tr>
                                    <td>@a.Merchant?.Name</td>
                                    <td><span class="tag">@a.EntityType</span></td>
                                    <td>@a.ChangeType</td>
                                    <td style="max-width:320px;">@a.Summary</td>
                                    <td style="font-size:var(--t-xs);color:var(--text-muted);">@a.RequestedBy</td>
                                    <td><StatusPill Status="@a.Status" /></td>
                                    <td>
                                        @if (a.Status == "Pending")
                                        {
                                            <div style="display:flex;gap:4px;">
                                                <button class="btn btn-sm btn-primary" @onclick='() => ReviewApproval(a, "Approved")'>Setujui</button>
                                                <button class="btn btn-sm btn-ghost" @onclick='() => ReviewApproval(a, "Rejected")'>Tolak</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span style="color:var(--text-muted);font-size:var(--t-xs);">@a.ReviewNote</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                break;

            case "promos":
                <div style="display:flex;justify-content:space-between;align-items:center;gap:var(--s-3);flex-wrap:wrap;margin-bottom:var(--s-3);">
                    <p class="hint" style="margin:0;">Buat, ubah, aktifkan, atau nonaktifkan voucher.</p>
                    <button class="btn btn-primary btn-sm" @onclick="NewVoucher">Voucher baru</button>
                </div>

                @if (_voucherForm is not null)
                {
                    <div class="card" style="margin-bottom:var(--s-4);">
                        <h3 style="margin-bottom:var(--s-3);">@(_voucherForm.Id == Guid.Empty ? "Voucher baru" : "Ubah voucher")</h3>
                        <div class="grid grid-3">
                            <div class="field">
                                <label for="v-code">Kode</label>
                                <input id="v-code" @bind="_voucherForm.Code" placeholder="JOKA50" />
                            </div>
                            <div class="field">
                                <label for="v-name">Nama</label>
                                <input id="v-name" @bind="_voucherForm.Name" />
                            </div>
                            <div class="field">
                                <label for="v-type">Tipe</label>
                                <select id="v-type" @bind="_voucherForm.Type">
                                    <option value="Percentage">Persentase</option>
                                    <option value="FixedAmount">Nominal tetap</option>
                                    <option value="Cashback">Cashback</option>
                                </select>
                            </div>
                            <div class="field">
                                <label for="v-value">Nilai (@(_voucherForm.Type == "Percentage" ? "%" : "Rp"))</label>
                                <input id="v-value" type="number" min="0" @bind="_voucherForm.Value" />
                            </div>
                            <div class="field">
                                <label for="v-min">Min. transaksi</label>
                                <input id="v-min" type="number" min="0" step="10000" @bind="_voucherForm.MinPurchase" />
                            </div>
                            <div class="field">
                                <label for="v-max">Plafon diskon</label>
                                <input id="v-max" type="number" min="0" step="10000" @bind="_voucherForm.MaxDiscount" />
                            </div>
                            <div class="field">
                                <label for="v-from">Berlaku dari</label>
                                <input id="v-from" type="date" @bind="_voucherForm.ValidFrom" />
                            </div>
                            <div class="field">
                                <label for="v-until">Berlaku sampai</label>
                                <input id="v-until" type="date" @bind="_voucherForm.ValidUntil" />
                            </div>
                            <div class="field">
                                <label for="v-quota">Kuota</label>
                                <input id="v-quota" type="number" min="1" @bind="_voucherForm.TotalQuota" />
                            </div>
                            <div class="field">
                                <label for="v-scope">Berlaku untuk</label>
                                <select id="v-scope" @bind="_voucherForm.ApplicableTo">
                                    <option value="All">Semua produk</option>
                                    <option value="flight">Pesawat</option>
                                    <option value="train">Kereta</option>
                                    <option value="bus">Bus &amp; Shuttle</option>
                                    <option value="hotel">Hotel</option>
                                </select>
                            </div>
                        </div>

                        @if (_voucherError is not null)
                        {
                            <p class="note-bad">@_voucherError</p>
                        }

                        <div style="display:flex;gap:var(--s-2);margin-top:var(--s-4);">
                            <button class="btn btn-primary" @onclick="SaveVoucher">Simpan</button>
                            <button class="btn btn-ghost" @onclick="() => _voucherForm = null">Batal</button>
                        </div>
                    </div>
                }
                <div class="table-scroll">
                    <table class="data-table">
                        <thead><tr><th>Kode</th><th>Nama</th><th>Tipe</th><th class="num">Nilai</th><th class="num">Terpakai</th><th>Berlaku sampai</th><th>Status</th><th>Aksi</th></tr></thead>
                        <tbody>
                            @foreach (var v in _vouchers)
                            {
                                <tr>
                                    <td class="code"><strong>@v.Code</strong></td>
                                    <td>@v.Name</td>
                                    <td>@v.Type</td>
                                    <td class="num">@(v.Type == "Percentage" ? $"{v.Value:0.#}%" : Rupiah(v.Value))</td>
                                    <td class="num">@v.UsedCount / @v.TotalQuota</td>
                                    <td>@v.ValidUntil.ToString("dd MMM yyyy")</td>
                                    <td><StatusPill Status="@(v.IsActive ? "Active" : "Suspended")" /></td>
                                    <td style="white-space:nowrap;">
                                        <button class="btn btn-sm btn-ghost" @onclick="() => EditVoucher(v)">Ubah</button>
                                        <button class="btn btn-sm btn-ghost" @onclick="() => ToggleVoucher(v)">
                                            @(v.IsActive ? "Nonaktifkan" : "Aktifkan")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                break;

            case "reviews":
                <p class="hint">
                    Ulasan tamu tidak langsung tayang. Rating hotel dihitung ulang dari
                    ulasan yang <strong>disetujui</strong> saja — menolak ulasan benar-benar
                    menarik bintangnya kembali.
                </p>

                <div class="filter-bar">
                    @foreach (var f in _reviewFilters)
                    {
                        <button class="tag @(_reviewFilter == f.Key ? "active" : "")"
                                @onclick="() => SetReviewFilter(f.Key)">
                            @f.Label (@CountReviews(f.Key))
                        </button>
                    }
                </div>

                @if (_reviewError is not null)
                {
                    <p class="err">@_reviewError</p>
                }

                @if (!FilteredReviews.Any())
                {
                    <div class="empty"><p>Tidak ada ulasan pada filter ini.</p></div>
                }
                else
                {
                    <div class="review-list">
                        @foreach (var r in FilteredReviews)
                        {
                            <article class="review @(r.Status == "Pending" ? "waiting" : "")">
                                <div class="review-top">
                                    <div>
                                        <strong>@(r.Title ?? "Tanpa judul")</strong>
                                        <div class="review-meta">
                                            @r.Hotel?.Name · @r.AuthorName ·
                                            menginap @r.StayDate.ToString("MMM yyyy") ·
                                            <span class="code">@(new string('★', Math.Clamp(r.Rating, 0, 5)))@(new string('☆', 5 - Math.Clamp(r.Rating, 0, 5)))</span>
                                        </div>
                                    </div>
                                    <div style="display:flex;gap:var(--s-2);align-items:center;flex-wrap:wrap;">
                                        @if (r.IsVerified)
                                        {
                                            <span class="badge badge-success">Terverifikasi menginap</span>
                                        }
                                        <StatusPill Status="@r.Status" />
                                    </div>
                                </div>

                                <p class="review-body">@r.Comment</p>

                                @if (r.Pros is not null || r.Cons is not null)
                                {
                                    <div class="review-pc">
                                        @if (r.Pros is not null) { <span>👍 @r.Pros</span> }
                                        @if (r.Cons is not null) { <span>👎 @r.Cons</span> }
                                    </div>
                                }

                                @if (r.Status == "Pending")
                                {
                                    <div class="review-actions">
                                        <input placeholder="Catatan / alasan (wajib untuk menolak)"
                                               value="@GetNote(r.Id)"
                                               @oninput="e => SetNote(r.Id, e.Value?.ToString())" />
                                        <button class="btn btn-sm btn-primary" @onclick='() => Moderate(r, "Approved")'>Setujui</button>
                                        <button class="btn btn-sm btn-ghost" @onclick='() => Moderate(r, "Rejected")'>Tolak</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="review-decided">
                                        @r.Status oleh @r.ModeratedBy · @r.ModeratedAt?.ToString("dd MMM yyyy HH:mm")
                                        @if (r.ModerationNote is not null)
                                        {
                                            <span> — @r.ModerationNote</span>
                                        }
                                    </div>
                                }
                            </article>
                        }
                    </div>
                }
                break;

            case "integrations":
                <p class="hint">Koneksi ke sistem maskapai, hotel, transportasi, dan pembayaran.</p>
                <div class="table-scroll">
                    <table class="data-table">
                        <thead><tr><th>Integrasi</th><th>Provider</th><th>Kategori</th><th>Environment</th><th>Status</th><th class="num">Latensi</th><th>Sinkron terakhir</th><th>Aksi</th></tr></thead>
                        <tbody>
                            @foreach (var i in _integrations)
                            {
                                <tr>
                                    <td><strong>@i.Name</strong>
                                        @if (i.LastError is not null)
                                        {
                                            <div style="color:var(--accent-danger);font-size:var(--t-xs);">@i.LastError</div>
                                        }
                                    </td>
                                    <td>@i.Provider</td>
                                    <td><span class="tag">@i.Category</span></td>
                                    <td><StatusPill Status="@i.Environment" /></td>
                                    <td><StatusPill Status="@i.Status" /></td>
                                    <td class="num">@(i.LastLatencyMs.HasValue ? $"{i.LastLatencyMs} ms" : "—")</td>
                                    <td style="color:var(--text-muted);">@(i.LastSyncAt?.ToString("dd MMM HH:mm") ?? "—")</td>
                                    <td>
                                        <button class="btn btn-sm btn-ghost" @onclick="() => ToggleIntegration(i)">
                                            @(i.IsEnabled ? "Matikan" : "Nyalakan")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                break;

            case "audit":
                <p class="hint">Catatan aktivitas admin, operator, dan sistem.</p>
                <div class="table-scroll">
                    <table class="data-table">
                        <thead><tr><th>Waktu</th><th>Aktor</th><th>Aksi</th><th>Entitas</th><th>Perubahan</th></tr></thead>
                        <tbody>
                            @foreach (var a in _audit)
                            {
                                <tr>
                                    <td style="white-space:nowrap;color:var(--text-muted);">@a.Timestamp.ToString("dd MMM HH:mm")</td>
                                    <td style="font-size:var(--t-xs);">@a.UserId</td>
                                    <td><span class="tag">@a.Action</span></td>
                                    <td>@a.EntityName <span style="color:var(--text-muted);">@a.EntityId</span></td>
                                    <td class="code" style="font-size:var(--t-xs);color:var(--text-secondary);">@a.Changes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                break;
        }
    }
</div>

<style>
    .hint { font-size: var(--t-sm); color: var(--text-secondary); margin-bottom: var(--s-3); }

    .chart-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: var(--s-4);
        margin-bottom: var(--s-6);
    }

    .filter-bar { display: flex; gap: var(--s-2); flex-wrap: wrap; margin-bottom: var(--s-4); }
    .filter-bar .tag { cursor: pointer; }
    .err { color: var(--accent-danger); font-size: var(--t-sm); font-weight: 600; margin-bottom: var(--s-3); }

    .review-list { display: flex; flex-direction: column; gap: var(--s-3); }

    .review {
        padding: var(--s-4);
        background: var(--bg-secondary);
        border: 2px solid var(--border-color);
        border-radius: var(--radius-lg);
    }
    /* Left bar rather than a tint, so it survives the dark theme. */
    .review.waiting { border-left: 6px solid var(--accent-secondary); }

    .review-top {
        display: flex; justify-content: space-between; align-items: flex-start;
        gap: var(--s-3); flex-wrap: wrap; margin-bottom: var(--s-2);
    }
    .review-meta { font-size: var(--t-xs); color: var(--text-muted); margin-top: 2px; }
    .review-body { font-size: var(--t-sm); color: var(--text-secondary); }

    .review-pc {
