@code {
    private record Tab(string Key, string Label);

    private readonly Tab[] _tabs =
    {
        new("overview", "Ringkasan"), new("users", "Pengguna & Role"), new("transactions", "Transaksi"),
        new("settlement", "Settlement"), new("fraud", "Fraud"), new("approvals", "Approval"),
        new("promos", "Promo"), new("reviews", "Ulasan"),
        new("integrations", "Integrasi API"), new("audit", "Audit Log")
    };

    private readonly Tab[] _reviewFilters =
    {
        new("Pending", "Menunggu"), new("Approved", "Tayang"),
        new("Rejected", "Ditolak"), new("", "Semua")
    };

    private string _tab = "overview";
    private bool _loading = true, _probing;
    private PromoVoucher? _voucherForm;
    private string? _voucherError;

    private List<User> _users = new();
    private List<Merchant> _merchants = new();
    private List<MerchantSettlement> _settlements = new();
    private List<FraudAlert> _fraud = new();
    private List<ApprovalRequest> _approvals = new();
    private List<PromoVoucher> _vouchers = new();
    private List<ApiIntegration> _integrations = new();
    private List<SystemHealthCheck> _health = new();
    private List<AuditLog> _audit = new();
    private List<PaymentTransaction> _transactions = new();

    private int _txCount, _openFraud, _pendingApprovals;
    private decimal _txVolume;

    private List<Chart.Point> _revenueTrend = new(), _byMethod = new(), _byProduct = new(), _userGrowth = new();

    private List<HotelReview> _reviews = new();
    private readonly Dictionary<Guid, string> _reviewNotes = new();
    private string _reviewFilter = "Pending";
    private string? _reviewError;

    private IEnumerable<HotelReview> FilteredReviews =>
        string.IsNullOrEmpty(_reviewFilter) ? _reviews : _reviews.Where(r => r.Status == _reviewFilter);

    private int CountReviews(string key) =>
        string.IsNullOrEmpty(key) ? _reviews.Count : _reviews.Count(r => r.Status == key);

    private void SetReviewFilter(string key)
    {
        _reviewFilter = key;
        _reviewError = null;
    }

    private string GetNote(Guid id) => _reviewNotes.GetValueOrDefault(id, "");
    private void SetNote(Guid id, string? value) => _reviewNotes[id] = value ?? "";

    private async Task Moderate(HotelReview review, string decision)
    {
        _reviewError = null;

        var (success, message) = await Reviews.ModerateAsync(
            review.Id, decision, "admin@joka.id", GetNote(review.Id));

        if (!success)
        {
            _reviewError = message;
            return;
        }

        _reviewNotes.Remove(review.Id);

        await Audit("HotelReview", review.Hotel?.Name ?? review.HotelId.ToString(), decision,
            $"Rating {review.Rating}★ oleh {review.AuthorName} -> {decision}");

        await LoadAsync();
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;

        // Tracked on purpose: this console edits these rows in place.
        _users = await DbContext.Users.OrderBy(u => u.Role).ThenBy(u => u.Username).ToListAsync();
        _merchants = await DbContext.Merchants.ToListAsync();
        _settlements = await DbContext.MerchantSettlements.Include(s => s.Merchant)
            .OrderByDescending(s => s.PeriodEnd).ToListAsync();
        _fraud = await DbContext.FraudAlerts.OrderByDescending(f => f.RiskScore).ToListAsync();
        _approvals = await DbContext.ApprovalRequests.Include(a => a.Merchant)
            .OrderBy(a => a.Status == "Pending" ? 0 : 1).ThenByDescending(a => a.CreatedAt).ToListAsync();
        _vouchers = await DbContext.PromoVouchers.OrderByDescending(v => v.ValidUntil).ToListAsync();
        _integrations = await DbContext.ApiIntegrations.ToListAsync();
        _health = await DbContext.SystemHealthChecks.AsNoTracking().ToListAsync();
        _audit = await DbContext.AuditLogs.AsNoTracking().OrderByDescending(a => a.Timestamp).Take(50).ToListAsync();
        _transactions = await DbContext.PaymentTransactions.AsNoTracking()
            .OrderByDescending(t => t.CreatedAt).Take(50).ToListAsync();

        _txCount = await DbContext.PaymentTransactions.CountAsync();
        // What was actually charged, not the pre-discount subtotal.
        _txVolume = _transactions.Sum(t => t.FinalAmount);
        _openFraud = _fraud.Count(f => f.Status is "Open" or "Reviewing");
        _pendingApprovals = _approvals.Count(a => a.Status == "Pending");

        _reviews = await Reviews.GetForModerationAsync();

        _revenueTrend = ToPoints(await Analytics.RevenueByDayAsync());
        _byMethod = ToPoints(await Analytics.TransactionsByMethodAsync());
        _byProduct = ToPoints(await Analytics.BookingsByProductAsync());
        _userGrowth = ToPoints(await Analytics.UserGrowthAsync());

        _loading = false;
    }

    private static List<Chart.Point> ToPoints(IEnumerable<ChartPoint> src) =>
        src.Select(p => new Chart.Point(p.Label, p.Value)).ToList();

    // Every mutation writes an audit row - that is the point of the audit tab.
    private async Task Audit(string entity, string id, string action, string change)
    {
        DbContext.AuditLogs.Add(new AuditLog
        {
            EntityName = entity, EntityId = id, Action = action,
            Changes = change, UserId = "admin@joka.id", Timestamp = DateTime.UtcNow
        });
        await DbContext.SaveChangesAsync();
    }

    private async Task ChangeRole(User user, string? role)
    {
        if (string.IsNullOrEmpty(role) || role == user.Role) return;

        var before = user.Role;
        user.Role = role;
        user.UpdatedAt = DateTime.UtcNow;
        await Audit("User", user.Email, "ChangeRole", $"Role: {before} -> {role}");
        await LoadAsync();
    }

    private async Task ToggleBlock(User user)
    {
        user.IsBlocked = !user.IsBlocked;
        user.BlockedAt = user.IsBlocked ? DateTime.UtcNow : null;
        user.BlockedBy = user.IsBlocked ? "admin@joka.id" : null;
        user.BlockedReason = user.IsBlocked ? "Diblokir manual oleh admin" : null;

        await Audit("User", user.Email, user.IsBlocked ? "Block" : "Unblock",
            $"IsBlocked: {!user.IsBlocked} -> {user.IsBlocked}");
        await LoadAsync();
    }

    private async Task MarkPaid(MerchantSettlement s)
    {
        s.Status = "Paid";
        s.PaidAt = DateTime.UtcNow;
        await Audit("MerchantSettlement", s.ReferenceNo, "Pay", $"Status -> Paid ({Rupiah(s.NetAmount)})");
        await LoadAsync();
    }

    private async Task ResolveFraud(FraudAlert f, string status)
    {
        f.Status = status;
        f.ReviewedBy = "admin@joka.id";
        f.ReviewedAt = DateTime.UtcNow;
        await Audit("FraudAlert", f.TransactionCode, status, $"Status -> {status}");
        await LoadAsync();
    }

    private async Task ReviewApproval(ApprovalRequest a, string status)
    {
        a.Status = status;
        a.ReviewedBy = "admin@joka.id";
        a.ReviewedAt = DateTime.UtcNow;

        var applied = status == "Approved" ? await ApplyPayloadAsync(a) : null;

        a.ReviewNote = status == "Approved"
            ? applied ?? "Disetujui, tapi perubahan tidak bisa diterapkan otomatis."
            : "Ditolak admin.";

        await Audit("ApprovalRequest", $"{a.EntityType}/{a.EntityId}", status, a.ReviewNote);
        await LoadAsync();
    }

    /// <summary>
    /// Approving used to only flip a status; the proposed values never reached
    /// the product tables. This applies the payload for the change types the
    /// merchant portal can actually submit.
    /// </summary>
    private async Task<string?> ApplyPayloadAsync(ApprovalRequest a)
    {
        if (string.IsNullOrWhiteSpace(a.PayloadJson)) return null;

        System.Text.Json.JsonElement root;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(a.PayloadJson);
            root = doc.RootElement.Clone();
        }
        catch { return null; }

        if (a.ChangeType == "Create") return await ApplyCreateAsync(a, root);
        if (a.ChangeType == "Delete") return await ApplyDeleteAsync(a);

        if (!Guid.TryParse(a.EntityId, out var id)) return null;

        var price = root.TryGetProperty("Price", out var p) && p.TryGetDecimal(out var v)
            ? (decimal?)v : null;

        if (price is not decimal newPrice) return null;

        switch (a.EntityType)
        {
            case "Room":
                var room = await DbContext.Rooms.FirstOrDefaultAsync(r => r.Id == id);
                if (room is null) return null;
                var oldRoom = room.PricePerNight;
                room.PricePerNight = newPrice;
                return $"Harga {room.Name}: {Rupiah(oldRoom)} → {Rupiah(newPrice)}";

            case "BusSchedule":
                var sched = await DbContext.BusSchedules.FirstOrDefaultAsync(s => s.Id == id);
                if (sched is null) return null;
                var oldBus = sched.BasePrice;
                sched.BasePrice = newPrice;
                return $"Harga jadwal bus: {Rupiah(oldBus)} → {Rupiah(newPrice)}";

            case "Flight":
                var flight = await DbContext.Flights.FirstOrDefaultAsync(f => f.Id == id);
                if (flight is null) return null;
                var oldFlight = flight.BasePrice;
                flight.BasePrice = newPrice;
                return $"Harga {flight.FlightNumber}: {Rupiah(oldFlight)} → {Rupiah(newPrice)}";

            case "Activity":
                var act = await DbContext.Activities.FirstOrDefaultAsync(x => x.Id == id);
                if (act is null) return null;
                var oldAct = act.Price;
                act.Price = newPrice;
                return $"Harga {act.Name}: {Rupiah(oldAct)} → {Rupiah(newPrice)}";

            default:
                return null;
        }
    }

    /// <summary>Inserts the record the merchant proposed into the live catalogue.</summary>
    private async Task<string?> ApplyCreateAsync(ApprovalRequest a, System.Text.Json.JsonElement root)
    {
        switch (a.EntityType)
        {
            case "BusSchedule":
                if (!root.TryGetProperty("BusServiceId", out var svcEl) || !svcEl.TryGetGuid(out var svcId) ||
                    !root.TryGetProperty("DepartureTerminalId", out var fromEl) || !fromEl.TryGetGuid(out var fromId) ||
                    !root.TryGetProperty("ArrivalTerminalId", out var toEl) || !toEl.TryGetGuid(out var toId) ||
                    !root.TryGetProperty("DepartureTime", out var depEl) || !depEl.TryGetDateTime(out var departure) ||
                    !root.TryGetProperty("DurationMinutes", out var durEl) || !durEl.TryGetInt32(out var duration) ||
                    !root.TryGetProperty("Price", out var priceEl) || !priceEl.TryGetDecimal(out var busPrice))
                    return null;

                var service = await DbContext.BusServices.AsNoTracking().FirstOrDefaultAsync(b => b.Id == svcId);
                if (service is null) return null;

                DbContext.BusSchedules.Add(new Joka.Models.Buses.BusSchedule
                {
                    BusServiceId = svcId,
                    DepartureTerminalId = fromId,
                    ArrivalTerminalId = toId,
                    DepartureTime = departure,
                    ArrivalTime = departure.AddMinutes(duration),
                    DurationMinutes = duration,
                    BasePrice = busPrice,
                    AvailableSeats = service.TotalSeats,
                    IsActive = true
                });

                return $"Jadwal bus baru ditambahkan ({Rupiah(busPrice)})";

            case "TravelPackage":
                if (!root.TryGetProperty("Name", out var nameEl) ||
                    !root.TryGetProperty("Destination", out var destEl) ||
                    !root.TryGetProperty("DurationDays", out var daysEl) || !daysEl.TryGetInt32(out var days) ||
                    !root.TryGetProperty("Price", out var pkgPriceEl) || !pkgPriceEl.TryGetDecimal(out var pkgPrice))
                    return null;

                var includes = root.TryGetProperty("Includes", out var incEl)
                    ? incEl.ToString()
                    : "[]";

                DbContext.TravelPackages.Add(new TravelPackage
                {
                    MerchantOwned = true,
                    Name = nameEl.GetString() ?? "Paket",
                    Destination = destEl.GetString() ?? "",
                    DurationDays = days,
                    Price = pkgPrice,
                    Includes = includes,
                    ImageUrl = root.TryGetProperty("ImageUrl", out var imgEl) ? imgEl.GetString() : null,
                    IsActive = true
                });

                return $"Paket \"{nameEl.GetString()}\" ditambahkan ke katalog";

            case "Room":
                if (!root.TryGetProperty("HotelId", out var hotelEl) || !hotelEl.TryGetGuid(out var hotelId) ||
                    !root.TryGetProperty("Name", out var roomNameEl) ||
                    !root.TryGetProperty("Capacity", out var capEl) || !capEl.TryGetInt32(out var capacity) ||
                    !root.TryGetProperty("Price", out var roomPriceEl) || !roomPriceEl.TryGetDecimal(out var roomPrice) ||
                    !root.TryGetProperty("TotalRooms", out var totalEl) || !totalEl.TryGetInt32(out var totalRooms))
                    return null;

                DbContext.Rooms.Add(new Room
                {
                    HotelId = hotelId,
                    Name = roomNameEl.GetString() ?? "Kamar",
                    Type = root.TryGetProperty("Type", out var typeEl) ? typeEl.GetString() ?? "Standard" : "Standard",
                    Capacity = capacity,
                    PricePerNight = roomPrice,
                    TotalRooms = totalRooms,
                    AvailableRooms = totalRooms,
                    HasBreakfast = root.TryGetProperty("HasBreakfast", out var bfEl) && bfEl.GetBoolean(),
                    IsActive = true
                });

                return $"Kamar \"{roomNameEl.GetString()}\" ditambahkan ({Rupiah(roomPrice)}/malam)";

            case "Activity":
                if (!root.TryGetProperty("Name", out var actNameEl) ||
                    !root.TryGetProperty("City", out var cityEl) ||
                    !root.TryGetProperty("Price", out var actPriceEl) || !actPriceEl.TryGetDecimal(out var actPrice) ||
                    !root.TryGetProperty("TotalTickets", out var ticketsEl) || !ticketsEl.TryGetInt32(out var tickets))
                    return null;

                DbContext.Activities.Add(new Activity
                {
                    Name = actNameEl.GetString() ?? "Aktivitas",
                    Category = root.TryGetProperty("Category", out var catEl) ? catEl.GetString() ?? "Tour" : "Tour",
                    City = cityEl.GetString() ?? "",
                    Location = root.TryGetProperty("Location", out var locEl) ? locEl.GetString() : null,
                    Description = root.TryGetProperty("Description", out var descEl) ? descEl.GetString() : null,
                    ImageUrl = root.TryGetProperty("ImageUrl", out var actImgEl) ? actImgEl.GetString() : null,
                    Price = actPrice,
                    TotalTickets = tickets,
                    DurationMinutes = root.TryGetProperty("DurationMinutes", out var durMinEl) && durMinEl.TryGetInt32(out var dm) ? dm : 0,
                    MerchantId = a.MerchantId,
                    IsActive = true
                });

                return $"Aktivitas \"{actNameEl.GetString()}\" ditambahkan ke katalog";

            default:
                return null;
        }
    }

    /// <summary>Soft-deletes so the record stays auditable and bookings keep resolving.</summary>
    private async Task<string?> ApplyDeleteAsync(ApprovalRequest a)
    {
        if (!Guid.TryParse(a.EntityId, out var id)) return null;

        switch (a.EntityType)
        {
            case "Activity":
                var act = await DbContext.Activities.FirstOrDefaultAsync(x => x.Id == id);
                if (act is null) return null;
                act.IsDeleted = true;
                return $"Aktivitas \"{act.Name}\" dihapus dari katalog";

            case "BusSchedule":
                var sched = await DbContext.BusSchedules.FirstOrDefaultAsync(s => s.Id == id);
                if (sched is null) return null;
                sched.IsActive = false;
                return "Jadwal bus dinonaktifkan";

            case "Room":
                var room = await DbContext.Rooms.FirstOrDefaultAsync(r => r.Id == id);
                if (room is null) return null;
                room.IsActive = false;
                return $"Kamar \"{room.Name}\" dinonaktifkan";

            default:
                return null;
        }
    }

    private async Task ToggleVoucher(PromoVoucher v)
    {
        v.IsActive = !v.IsActive;
        await Audit("PromoVoucher", v.Code, "Update", $"IsActive -> {v.IsActive}");
        await LoadAsync();
    }

    // ---------------- Voucher create / edit ----------------
    private void NewVoucher()
    {
        _voucherError = null;
        _voucherForm = new PromoVoucher
        {
            Id = Guid.Empty,
            Type = "Percentage",
            ApplicableTo = "All",
            ValidFrom = DateTime.UtcNow.Date,
            ValidUntil = DateTime.UtcNow.Date.AddMonths(1),
            TotalQuota = 100,
            IsActive = true
        };
    }

    private void EditVoucher(PromoVoucher v)
    {
        _voucherError = null;
        // Copy so an abandoned edit does not leave the tracked entity dirty.
        _voucherForm = new PromoVoucher
        {
            Id = v.Id, Code = v.Code, Name = v.Name, Description = v.Description,
            Type = v.Type, Value = v.Value, MinPurchase = v.MinPurchase, MaxDiscount = v.MaxDiscount,
            ValidFrom = v.ValidFrom, ValidUntil = v.ValidUntil,
            TotalQuota = v.TotalQuota, UsedCount = v.UsedCount,
            ApplicableTo = v.ApplicableTo, IsActive = v.IsActive
        };
    }

    private async Task SaveVoucher()
    {
        if (_voucherForm is null) return;

        var form = _voucherForm;
        var code = form.Code?.Trim().ToUpperInvariant() ?? "";

        if (string.IsNullOrWhiteSpace(code)) { _voucherError = "Kode wajib diisi."; return; }
        if (string.IsNullOrWhiteSpace(form.Name)) { _voucherError = "Nama wajib diisi."; return; }
        if (form.Value <= 0) { _voucherError = "Nilai harus lebih besar dari nol."; return; }
        if (form.Type == "Percentage" && form.Value > 100) { _voucherError = "Persentase tidak boleh di atas 100."; return; }
        if (form.ValidUntil <= form.ValidFrom) { _voucherError = "Tanggal berakhir harus setelah tanggal mulai."; return; }
        if (form.TotalQuota < 1) { _voucherError = "Kuota minimal 1."; return; }

        var duplicate = await DbContext.PromoVouchers
            .AnyAsync(v => v.Code == code && v.Id != form.Id);

        if (duplicate) { _voucherError = $"Kode {code} sudah dipakai voucher lain."; return; }

        if (form.Id == Guid.Empty)
        {
            form.Code = code;
            DbContext.PromoVouchers.Add(form);
            await Audit("PromoVoucher", code, "Create", $"{form.Type} {form.Value}, kuota {form.TotalQuota}");
        }
        else
        {
            var existing = await DbContext.PromoVouchers.FirstOrDefaultAsync(v => v.Id == form.Id);
            if (existing is null) { _voucherError = "Voucher tidak ditemukan."; return; }

            existing.Code = code;
            existing.Name = form.Name;
            existing.Type = form.Type;
            existing.Value = form.Value;
            existing.MinPurchase = form.MinPurchase;
            existing.MaxDiscount = form.MaxDiscount;
            existing.ValidFrom = form.ValidFrom;
            existing.ValidUntil = form.ValidUntil;
            existing.TotalQuota = form.TotalQuota;
            existing.ApplicableTo = form.ApplicableTo;
            existing.UpdatedAt = DateTime.UtcNow;

            await Audit("PromoVoucher", code, "Update", $"Nilai {form.Value}, kuota {form.TotalQuota}");
        }

        _voucherForm = null;
        await LoadAsync();
    }

    private async Task RefreshHealth()
    {
        _probing = true;
        try
        {
            _health = await HealthProbe.ProbeAsync();
        }
        finally { _probing = false; }
    }

    private async Task ToggleIntegration(ApiIntegration i)
    {
        i.IsEnabled = !i.IsEnabled;
        await Audit("ApiIntegration", i.Name, "Update", $"IsEnabled -> {i.IsEnabled}");
        await LoadAsync();
    }

    private static string Rupiah(decimal v) => $"Rp{v:N0}";

    private static string RiskColor(int score) => score >= 80 ? "var(--accent-danger)"
        : score >= 60 ? "var(--accent-warning)" : "var(--text-secondary)";
}
