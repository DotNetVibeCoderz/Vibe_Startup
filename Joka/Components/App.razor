<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FF5C35" />
    <meta name="description" content="Joka - pesan tiket pesawat, kereta, hotel, rental mobil, dan aktivitas wisata dalam satu tempat." />
    <base href="/" />

    @* Apply the saved theme before first paint so the page never flashes light-then-dark *@
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('joka-theme');
                var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', theme);
            } catch { document.documentElement.setAttribute('data-theme', 'light'); }
        })();
    </script>

    @*
        Three type roles:
        Bricolage Grotesque - display, used with restraint
        Plus Jakarta Sans   - body (Tokotype's typeface for Jakarta's city identity)
        JetBrains Mono      - ticket data: codes, times, prices
    *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap">

    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="Joka.styles.css" />
    <HeadOutlet @rendermode="@PageRenderMode" />
</head>
<body>
    <Routes @rendermode="@PageRenderMode" />

    <div id="blazor-error-ui" style="display:none;">
        Koneksi ke server terputus.
        <a href="" class="reload">Muat ulang halaman</a>
    </div>

    <script src="_framework/blazor.web.js"></script>
    <script src="js/joka.js"></script>
    @* charts.js needs d3 in scope, so it must load after it. *@
    <script src="https://d3js.org/d3.v7.min.js"></script>
    <script src="js/charts.js"></script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Pages marked [ExcludeFromInteractiveRouting] render as static SSR, which is
    // the only place HttpContext is available - and SignInAsync needs it to write
    // the auth cookie. Everything else stays interactive.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? RenderMode.InteractiveServer : null;
}
