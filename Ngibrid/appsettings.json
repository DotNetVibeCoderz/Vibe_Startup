{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Ngibrid": "Information"
    }
  },
  "AllowedHosts": "*",
  "AppInfo": {
    "Name": "Ngibrid",
    "Version": "1.0.0",
    "Description": "Platform Manajemen Logistik Modern",
    "Company": "Ngibrid Logistics",
    "ContactEmail": "support@ngibrid.com"
  },
  "Database": {
    "Provider": "SQLite",
    "ConnectionStrings": {
      "SQLite": "Data Source=Data/ngibrid.db",
      "SQLServer": "Server=.;Database=NgibridDb;Trusted_Connection=true;TrustServerCertificate=true;",
      "MySQL": "Server=localhost;Database=NgibridDb;User=root;Password=root;",
      "Postgre": "Host=localhost;Database=NgibridDb;Username=postgres;Password=postgres;"
    }
  },
  "Storage": {
    "Provider": "FileSystem",
    "BasePath": "wwwroot/uploads",
    "MaxFileSizeMb": 25,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".svg",
      ".pdf",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx",
      ".csv"
    ],
    "AzureBlob": {
      "ConnectionString": "",
      "ContainerName": "ngibrid-storage"
    },
    "S3": {
      "AccessKey": "",
      "SecretKey": "",
      "BucketName": "ngibrid-storage",
      "ServiceUrl": "",
      "Region": "us-east-1"
    },
    "MinIO": {
      "Endpoint": "localhost:9000",
      "AccessKey": "minioadmin",
      "SecretKey": "minioadmin",
      "BucketName": "ngibrid-storage",
      "UseSSL": false
    }
  },
  "Auth": {
    "Jwt": {
      "Secret": "Ngibrid-Super-Secret-Key-2025-Min-32-Chars!",
      "Issuer": "Ngibrid",
      "Audience": "NgibridApp",
      "ExpireMinutes": 1440,
      "RefreshTokenExpireDays": 7
    },
    "Password": {
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true,
      "RequiredLength": 8,
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15
    }
  },
  "Shipment": {
    "DefaultCurrency": "IDR",
    "TaxRate": 0.11,
    "InsuranceRate": 0.02,
    "MaxPackageWeight": 50.0,
    "MaxPackageDimensions": {
      "Length": 100,
      "Width": 100,
      "Height": 100
    }
  },
  "GPS": {
    "Simulator": {
      "Enabled": true,
      "UpdateIntervalMs": 5000,
      "SpeedKmh": 40
    }
  },
  "IoT": {
    "Simulator": {
      "Enabled": true,
      "SensorUpdateIntervalMs": 10000,
      "TemperatureRange": {
        "Min": -10,
        "Max": 35
      },
      "HumidityRange": {
        "Min": 30,
        "Max": 90
      }
    },
    "LockerSimulator": {
      "Enabled": true,
      "UpdateIntervalMs": 30000
    }
  },
  "Loyalty": {
    "PointsPerRupiah": 0.0001,
    "RupiahPerPoint": 100
  },
  "Compliance": {
    "Customs": {
      "DutyRate": 0.075,
      "ImportVatRate": 0.11,
      "DeMinimisUsd": 3
    }
  },
  "AI": {
    "RouteOptimization": {
      "Enabled": true,
      "Algorithm": "GeneticAlgorithm",
      "MaxIterations": 1000
    },
    "DynamicPricing": {
      "Enabled": true,
      "BaseFare": 9000,
      "RatePerKm": 22,
      "UrgencyMultiplier": 1.5,
      "PeakHourMultiplier": 1.3,
      "WeekendMultiplier": 1.2
    },
    "Forecast": {
      "PeakSeasonThreshold": 1.25
    }
  },
  "ChatBot": {
    "Name": "Mas Supri",
    "Persona": "Kamu adalah Mas Supri, asisten virtual ramah dari Ngibrid Logistics yang siap membantu pelanggan. Kamu berbicara dengan bahasa Indonesia yang santai, ramah, dan kadang bercanda. Kamu bisa membantu tracking paket, cek tarif, info layanan, pickup request, dan pertanyaan seputar logistik. Jika ditanya hal di luar itu, arahkan kembali ke topik logistik.",
    "DefaultModel": "OpenAI",
    "Temperature": 0.7,
    "MaxTokens": 2000,
    "TopP": 0.95,
    "MaxHistoryMessages": 30,
    "Models": {
      "OpenAI": {
        "ApiKey": "sk-proj-xxx",
        "Model": "gpt-4o-mini",
        "Endpoint": "https://api.openai.com/v1"
      },
      "Anthropic": {
        "ApiKey": "",
        "Model": "claude-3-5-sonnet-20241022",
        "Endpoint": "https://api.anthropic.com/v1"
      },
      "Gemini": {
        "ApiKey": "",
        "Model": "gemini-2.0-flash",
        "Endpoint": "https://generativelanguage.googleapis.com/v1beta"
      },
      "Ollama": {
        "Model": "llama3.2",
        "Endpoint": "http://localhost:11434"
      }
    },
    "Tavily": {
      "ApiKey": "tvly-dev-xxx",
      "Endpoint": "https://api.tavily.com/search"
    }
  },
  "Notification": {
    "Email": {
      "SmtpServer": "smtp.gmail.com",
      "SmtpPort": 587,
      "Username": "",
      "Password": "",
      "FromAddress": "noreply@ngibrid.com",
      "FromName": "Ngibrid Logistics",
      "EnableSsl": true
    },
    "SMS": {
      "Provider": "Twilio",
      "AccountSid": "",
      "AuthToken": "",
      "FromNumber": ""
    },
    "PushNotification": {
      "FirebaseServerKey": "",
      "FcmEndpoint": "https://fcm.googleapis.com/fcm/send"
    }
  },
  "Payment": {
    "Midtrans": {
      "ServerKey": "",
      "ClientKey": "",
      "IsProduction": false
    },
    "Xendit": {
      "ApiKey": "",
      "IsProduction": false
    }
  },
  "Integration": {
    "Marketplace": {
      "Tokopedia": {
        "ApiKey": "",
        "Endpoint": "https://fs.tokopedia.net/v1"
      },
      "Shopee": {
        "ApiKey": "",
        "Endpoint": "https://partner.shopeemobile.com/api/v2"
      }
    }
  },
  "GreenLogistics": {
    "EmissionFactorGramCo2PerKm": 150,
    "EcoVehicleDiscount": 0.1,
    "CarbonOffsetPricePerKg": 500
  }
}