<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                <div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg-primary);">
                    <div class="card" style="padding:40px;text-align:center;max-width:500px;">
                        <span style="font-size:64px;">🔒</span>
                        <h2>Please Sign In</h2>
                        <p class="text-muted">You need to login to access this page.</p>
                        <a href="/login" class="btn btn-primary btn-lg" style="margin-top:16px;">Sign In</a>
                    </div>
                </div>
            </NotAuthorized>
            <Authorizing>
                <div style="text-align:center;padding:80px;">
                    <div class="spinner"></div><p>Loading...</p>
                </div>
            </Authorizing>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <div class="empty-state" style="padding:80px;">
            <div class="empty-state-icon">🔍</div>
            <h2>404 - Page Not Found</h2>
            <a href="/" class="btn btn-primary mt-md">🏠 Home</a>
        </div>
    </NotFound>
</Router>
