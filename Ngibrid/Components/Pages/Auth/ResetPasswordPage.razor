@page "/reset-password"
@layout Ngibrid.Components.Layout.BlankLayout
@using System.ComponentModel.DataAnnotations
@using Ngibrid.Components.Pages.Auth

<PageTitle>Reset Password - Ngibrid</PageTitle>

<div class="auth-shell">
    <div class="card auth-card">
        <div class="auth-brand">
            <span class="auth-logo">🔐</span>
            <h2>Reset Password</h2>
            <p class="text-muted">Buat password baru untuk akun Anda.</p>
        </div>

        @if (isSuccess)
        {
            <div class="alert alert-success" style="text-align:center;">
                <div style="font-size:40px;">✅</div>
                <h3 style="margin:8px 0;">Password Berhasil Diubah</h3>
                <p>Silakan masuk dengan password baru Anda.</p>
            </div>
            <a href="/login" class="btn btn-primary btn-lg" style="width:100%;">🔑 Login Sekarang</a>
        }
        else if (string.IsNullOrWhiteSpace(Token))
        {
            @* Without a token from the reset email there is nothing to verify, so the form is not shown. *@
            <div class="alert alert-warning">
                Tautan reset tidak valid atau sudah kedaluwarsa. Silakan minta tautan baru.
            </div>
            <a href="/forgot-password" class="btn btn-primary btn-lg" style="width:100%;">
                Minta Tautan Reset Baru
            </a>
        }
        else
        {
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <EditForm Model="model" OnValidSubmit="ResetPassword">
                <DataAnnotationsValidator />
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <InputText class="form-input" @bind-Value="model.Email" type="email"
                               readonly="@(!string.IsNullOrEmpty(Email))" />
                    <ValidationMessage For="() => model.Email" />
                </div>
                <div class="form-group">
                    <label class="form-label">Password Baru</label>
                    <InputText type="password" class="form-input" @bind-Value="model.NewPassword"
                               autocomplete="new-password" placeholder="Min. 8 karakter" />
                    <ValidationMessage For="() => model.NewPassword" />
                </div>
                <div class="form-group">
                    <label class="form-label">Konfirmasi Password</label>
                    <InputText type="password" class="form-input" @bind-Value="model.ConfirmPassword"
                               autocomplete="new-password" />
                    <ValidationMessage For="() => model.ConfirmPassword" />
                </div>
                <button type="submit" class="btn btn-primary btn-lg" style="width:100%;" disabled="@isBusy">
                    @(isBusy ? "Memproses…" : "🔐 Reset Password")
                </button>
            </EditForm>

            <div style="text-align:center;margin-top:16px;">
                <a href="/login">← Kembali ke Login</a>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "email")] private string? Email { get; set; }
    [SupplyParameterFromQuery(Name = "token")] private string? Token { get; set; }

    private readonly ResetModel model = new();
    private string? errorMessage;
    private bool isSuccess;
    private bool isBusy;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Email)) model.Email = Email;
    }

    /// <summary>
    /// The token from the reset email is required and passed through unchanged; the server
    /// validates it. The page never mints one itself.
    /// </summary>
    private async Task ResetPassword()
    {
        isBusy = true;
        errorMessage = null;

        try
        {
            var result = await JS.InvokeAsync<LoginPage.AuthResult>("ngibrid.postAuth",
                "/api/auth/reset-password", new
                {
                    email = model.Email,
                    token = Token,
                    newPassword = model.NewPassword,
                    confirmPassword = model.ConfirmPassword
                });

            if (result.Success) isSuccess = true;
            else errorMessage = result.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"Gagal menghubungi server: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private sealed class ResetModel
    {
        [Required(ErrorMessage = "Email wajib diisi")]
        [EmailAddress(ErrorMessage = "Format email tidak valid")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Password baru wajib diisi")]
        [MinLength(8, ErrorMessage = "Password minimal 8 karakter")]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Konfirmasi password wajib diisi")]
        [Compare(nameof(NewPassword), ErrorMessage = "Konfirmasi password tidak cocok")]
        public string ConfirmPassword { get; set; } = "";
    }
}
