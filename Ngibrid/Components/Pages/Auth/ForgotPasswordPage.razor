@page "/forgot-password"
@layout Ngibrid.Components.Layout.BlankLayout
@using System.ComponentModel.DataAnnotations
@using Ngibrid.Components.Pages.Auth

<PageTitle>Lupa Password - Ngibrid</PageTitle>

<div class="auth-shell">
    <div class="card auth-card">
        <div class="auth-brand">
            <span class="auth-logo">🔑</span>
            <h2>Lupa Password</h2>
            <p class="text-muted">Masukkan email Anda, kami kirimkan tautan reset.</p>
        </div>

        @if (isSent)
        {
            <div class="alert alert-success" style="text-align:center;">
                <div style="font-size:40px;">📧</div>
                <h3 style="margin:8px 0;">Permintaan Terkirim</h3>
                <p>Jika <strong>@model.Email</strong> terdaftar, tautan reset sudah dikirim ke email tersebut.</p>
                <p class="text-muted">Cek juga folder spam Anda.</p>
            </div>

            @if (!string.IsNullOrEmpty(devLink))
            {
                <div class="alert alert-info">
                    <strong>Mode development</strong> — SMTP belum dikonfigurasi, gunakan tautan ini:
                    <div style="margin-top:8px;"><a href="@devLink">@devLink</a></div>
                </div>
            }

            <a href="/login" class="btn btn-primary btn-lg" style="width:100%;margin-top:8px;">Kembali ke Login</a>
        }
        else
        {
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <EditForm Model="model" OnValidSubmit="SendResetLink">
                <DataAnnotationsValidator />
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <InputText class="form-input" @bind-Value="model.Email" type="email"
                               autocomplete="username" placeholder="email@example.com" />
                    <ValidationMessage For="() => model.Email" />
                </div>
                <button type="submit" class="btn btn-primary btn-lg" style="width:100%;" disabled="@isBusy">
                    @(isBusy ? "Mengirim…" : "📧 Kirim Tautan Reset")
                </button>
            </EditForm>

            <div style="text-align:center;margin-top:16px;">
                <a href="/login">← Kembali ke Login</a>
            </div>
        }
    </div>
</div>

@code {
    private readonly EmailModel model = new();
    private string? errorMessage;
    private string? devLink;
    private bool isSent;
    private bool isBusy;

    private async Task SendResetLink()
    {
        isBusy = true;
        errorMessage = null;

        try
        {
            var result = await JS.InvokeAsync<LoginPage.AuthResult>("ngibrid.postAuth",
                "/api/auth/forgot-password", new { email = model.Email });

            if (result.Success)
            {
                isSent = true;
                // The API only returns a link in Development, where SMTP is typically not configured.
                devLink = result.RedirectUrl;
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Gagal menghubungi server: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private sealed class EmailModel
    {
        [Required(ErrorMessage = "Email wajib diisi")]
        [EmailAddress(ErrorMessage = "Format email tidak valid")]
        public string Email { get; set; } = "";
    }
}
