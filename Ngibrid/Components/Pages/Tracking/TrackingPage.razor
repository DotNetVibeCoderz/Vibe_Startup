@page "/tracking"
@page "/tracking/{TrackingNumber}"
@inject OrderService OrderService
@inject TrackingService TrackingService
@inject GpsSimulatorService GpsSimulator
@implements IAsyncDisposable

<PageTitle>Shipment Tracking - Ngibrid</PageTitle>

<div class="page-header flex-between mb-md">
    <div><h1 style="font-size:24px;font-weight:800;">📍 Shipment Tracking</h1><p class="text-muted">Lacak posisi paket secara real-time dengan peta interaktif</p></div>
</div>

<div class="card mb-md">
    <div style="display:flex;gap:12px;">
        <input class="form-input" style="flex:1;" placeholder="Masukkan nomor tracking..." @bind="trackingInput" @onkeydown="OnSearchKeyDown" />
        <button class="btn btn-primary" @onclick="SearchTracking">🔍 Lacak</button>
        @if (order != null && order.Status != "DELIVERED")
        {
            <button class="btn @(isSimulating ? "btn-danger" : "btn-success")" @onclick="ToggleSimulation">@(isSimulating ? "⏹ Stop" : "▶ Simulasi GPS")</button>
        }
    </div>
</div>

@if (isLoading)
{
    <div class="empty-state"><div class="spinner"></div><p>Mencari paket...</p></div>
}
else if (order != null)
{
    <div class="grid grid-3 mb-md">
        <div class="card" style="grid-column:1/3;">
            <div class="card-header"><span class="card-title">📦 @order.OrderNumber</span><span class="badge @GetStatusBadge(order.Status)">@order.Status</span></div>
            <div class="grid grid-2">
                <div><strong>Tracking:</strong> <code>@order.TrackingNumber</code></div><div><strong>Service:</strong> @order.ServiceType</div>
                <div><strong>Pengirim:</strong> @order.SenderName (@order.SenderCity)</div><div><strong>Penerima:</strong> @order.RecipientName (@order.RecipientCity)</div>
                <div><strong>Berat:</strong> @order.WeightKg kg</div><div><strong>Estimasi:</strong> @order.EstimatedDeliveryDate?.ToString("dd MMM HH:mm")</div>
            </div>
        </div>
        <div class="card"><div class="card-header">📊 Status</div><div style="text-align:center;padding:16px;"><div style="font-size:48px;">@(isSimulating ? "🛰️" : "📍")</div><strong>@(isSimulating ? "Live Tracking" : order.Status)</strong></div></div>
    </div>

    <div class="card mb-md">
        <div class="card-header"><span class="card-title">🗺️ Live Map</span>@if (isSimulating) { <span class="badge badge-success">● LIVE</span> }</div>
        <div id="tracking-map" style="height:400px;border-radius:0 0 10px 10px;z-index:1;"></div>
    </div>

    <div class="card mb-md">
        <div class="card-header"><span class="card-title">📜 Status Timeline</span></div>
        <div class="timeline">
            @if (order.StatusHistory != null && order.StatusHistory.Any())
            {
                @foreach (var h in order.StatusHistory.OrderByDescending(x => x.CreatedAt))
                {
                    <div class="timeline-item">
                        <div class="timeline-marker @(h.Status == order.Status ? "active" : "")"></div>
                        <div class="timeline-content">
                            <div class="flex-between"><span class="badge @GetStatusBadge(h.Status)">@h.Status</span><small>@h.CreatedAt.ToString("dd MMM HH:mm")</small></div>
                            <p>@h.Notes</p>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <div class="card">
        <div class="card-header"><span class="card-title">🛰️ GPS Track Points</span></div>
        <div class="table-container">
            <table><thead><tr><th>Time</th><th>Lat</th><th>Lng</th><th>Speed</th><th>Event</th></tr></thead>
                <tbody>
                    @foreach (var t in trackingHistory.TakeLast(20).Reverse())
                    {
                        <tr><td>@t.Timestamp.ToString("HH:mm:ss")</td><td>@t.Latitude.ToString("F4")</td><td>@t.Longitude.ToString("F4")</td><td>@(t.SpeedKmh?.ToString("F0") ?? "-") km/h</td><td><span class="badge badge-info">@t.EventType</span></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (searched)
{
    @* Keyed off "a search actually ran", not off the textbox: binding fires on every change,
       so the old condition flashed "not found" while the user was still typing. *@
    <div class="alert alert-warning">❌ Paket <strong>@searchedFor</strong> tidak ditemukan.</div>
}

@code {
    [Parameter] public string? TrackingNumber { get; set; }
    private string trackingInput = "";
    private Order? order;
    private List<ShipmentTracking> trackingHistory = new();
    private bool isLoading, isSimulating, searched;
    private string searchedFor = "";
    private Timer? simTimer;
    private (double Lat, double Lng)? currentPos;
    private bool mapPending;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(TrackingNumber)) { trackingInput = TrackingNumber; await SearchTracking(); }
    }

    /// <summary>
    /// The map is drawn here, never from the search handler. Leaflet needs the &lt;div&gt; to exist,
    /// and it does not until Blazor has rendered the `order != null` branch; on the
    /// /tracking/{number} route the search also runs during prerender, where JS interop is illegal.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!mapPending || order == null) return;
        mapPending = false;
        try
        {
            await RenderMapAsync();
        }
        catch (JSDisconnectedException) { }
        catch (Exception) { /* the map is supplementary — never break the page over it */ }
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await SearchTracking(); }

    private async Task SearchTracking()
    {
        if (string.IsNullOrWhiteSpace(trackingInput)) return;
        StopAll(); isLoading = true;
        searchedFor = trackingInput.Trim();
        searched = true;
        order = await OrderService.GetByTrackingNumberAsync(searchedFor);
        if (order != null) { trackingHistory = await TrackingService.GetTrackingHistoryAsync(order.Id); if (!trackingHistory.Any() && order.Status != "CREATED") trackingHistory = GenerateTrackings(order); }
        isLoading = false;
        mapPending = order != null;
    }

    private async Task ToggleSimulation()
    {
        if (order == null) return;
        if (isSimulating) { StopAll(); }
        else
        {
            var (slat, slng) = GetCoords(order.SenderProvince, order.SenderCity);
            var (elat, elng) = GetCoords(order.RecipientProvince, order.RecipientCity);
            var last = trackingHistory.LastOrDefault();
            if (last != null) { slat = last.Latitude; slng = last.Longitude; }
            TrackingService.StartSimulation(order.Id, slat, slng, elat, elng);
            isSimulating = true; mapPending = true;
            var orderId = order.Id;
            simTimer = new Timer(async _ =>
            {
                // A timer tick runs off the circuit's synchronisation context and keeps firing while
                // the user navigates away, so every hop is guarded: an unhandled throw here would
                // tear down the whole circuit rather than just stop the animation.
                try
                {
                    var pos = GpsSimulator.GetActivePositions();
                    if (!pos.TryGetValue(orderId, out var p)) return;
                    currentPos = p;
                    await InvokeAsync(async () =>
                    {
                        await JS.InvokeVoidAsync("ngibrid.updateCurrentMarker", p.Lat, p.Lng);
                        trackingHistory = await TrackingService.GetTrackingHistoryAsync(orderId);
                        StateHasChanged();
                    });
                }
                catch (ObjectDisposedException) { }
                catch (JSDisconnectedException) { }
                catch (Exception) { /* keep the simulation alive through transient failures */ }
            }, null, 0, 2000);
        }
    }

    private void StopAll() { if (order != null) TrackingService.StopSimulation(order.Id); simTimer?.Dispose(); simTimer = null; isSimulating = false; currentPos = null; }

    private async Task RenderMapAsync()
    {
        if (order == null) return;
        var (clat, clng) = GetCoords(order.RecipientProvince, order.RecipientCity);
        var markers = trackingHistory.Select(t => new { lat = t.Latitude, lng = t.Longitude, type = t.EventType ?? "GPS_UPDATE", time = t.Timestamp.ToString("HH:mm"), speed = t.SpeedKmh?.ToString("F0") ?? "-" }).ToList();
        var (dlat, dlng) = GetCoords(order.RecipientProvince, order.RecipientCity);
        await JS.InvokeVoidAsync("ngibrid.renderTrackingMap", new { mapId = "tracking-map", centerLat = clat, centerLng = clng, markers, destination = new { lat = dlat, lng = dlng, city = order.RecipientCity }, current = currentPos != null ? new { lat = currentPos.Value.Lat, lng = currentPos.Value.Lng } : null });
    }

    private List<ShipmentTracking> GenerateTrackings(Order o)
    {
        var (slat, slng) = GetCoords(o.SenderProvince, o.SenderCity);
        var (elat, elng) = GetCoords(o.RecipientProvince, o.RecipientCity);
        var rng = new Random(o.OrderNumber.GetHashCode()); var pts = new List<ShipmentTracking>();
        for (int i = 0; i <= 8; i++)
        {
            var f = (double)i / 8;
            pts.Add(new ShipmentTracking { OrderId = o.Id, Latitude = Math.Round(slat + (elat - slat) * f + (rng.NextDouble() - 0.5) * 0.02, 6), Longitude = Math.Round(slng + (elng - slng) * f + (rng.NextDouble() - 0.5) * 0.02, 6), SpeedKmh = Math.Round(20 + rng.NextDouble() * 40, 1), EventType = i == 0 ? "PICKUP" : i == 8 ? "DELIVERY" : "GPS_UPDATE", Timestamp = o.CreatedAt.AddHours(i * 3) });
        }
        return pts;
    }

    // Shared with routing and the GPS simulator, so a city always resolves to the same point.
    // The old inline version used a fresh Random for unknown cities, which moved the marker on
    // every re-render.
    private (double, double) GetCoords(string? province, string? city) => CityCoordinates.Resolve(province, city);
    private string GetStatusBadge(string s) => s switch { "DELIVERED" => "badge-success", "IN_TRANSIT" or "OUT_FOR_DELIVERY" => "badge-info", "PICKED_UP" => "badge-warning", _ => "badge-default" };

    public async ValueTask DisposeAsync() { StopAll(); await Task.CompletedTask; }
}
