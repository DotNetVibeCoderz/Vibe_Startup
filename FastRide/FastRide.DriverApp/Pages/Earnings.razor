@page "/earnings"
@inject ApiClient Api

<div class="topbar">
    <div class="topbar__mark">Pendapatan</div>
</div>

<div class="screen">
    @if (_loading)
    {
        <div class="hero stack">
            <div class="skeleton" style="width:40%"></div>
            <div class="skeleton" style="height:32px"></div>
        </div>
    }
    else if (_earnings is null)
    {
        <div class="alert alert--error">Tidak bisa memuat pendapatan. Periksa koneksi ke server.</div>
    }
    else
    {
        <div class="hero">
            <span class="hero__label">Pendapatan hari ini</span>
            <div class="hero__value">@Display.Rupiah(_earnings.TodayEarnings)</div>
            <span class="small muted">@_earnings.TodayTrips trip · rata-rata @Display.Rupiah(_earnings.AveragePerTrip) per trip</span>
        </div>

        <div class="metrics metrics--3">
            <div class="metric"><span>7 hari</span><b>@Display.RupiahShort(_earnings.WeekEarnings)</b></div>
            <div class="metric"><span>30 hari</span><b>@Display.RupiahShort(_earnings.MonthEarnings)</b></div>
            <div class="metric"><span>Seumur akun</span><b>@Display.RupiahShort(_earnings.TotalEarnings)</b></div>
        </div>

        <div class="card card--flush">
            <div class="card__head">
                <h2>Rincian harian</h2>
                <span class="dim small">@_earnings.MonthTrips trip · 30 hari</span>
            </div>

            @if (_earnings.DailyBreakdown.Count == 0)
            {
                <div class="empty">
                    <i class="bi bi-calendar3"></i>
                    <strong>Belum ada trip selesai</strong>
                    <span>Aktifkan status dan ambil order untuk mulai mengumpulkan pendapatan.</span>
                </div>
            }
            else
            {
                <div class="rows">
                    @foreach (var day in _earnings.DailyBreakdown)
                    {
                        <div class="row-item">
                            <div class="row-item__body">
                                <strong>@Display.Date(day.Date)</strong>
                                <small>@day.Trips trip</small>
                                @* Bar width is relative to the best day, so the shape of the
                                   month is readable without an axis. *@
                                <div style="height:3px;background:var(--garis);border-radius:2px;margin-top:5px;">
                                    <div style="height:100%;border-radius:2px;background:var(--peran);width:@(BarWidth(day.Earnings))%"></div>
                                </div>
                            </div>
                            <div class="row-item__end money small">@Display.Rupiah(day.Earnings)</div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private DriverEarningsResponse? _earnings;
    private bool _loading = true;

    private decimal BestDay => _earnings?.DailyBreakdown.Count > 0
        ? _earnings.DailyBreakdown.Max(d => d.Earnings)
        : 0m;

    protected override async Task OnInitializedAsync()
    {
        _earnings = await Api.GetEarningsAsync();
        _loading = false;
    }

    private int BarWidth(decimal earnings) =>
        BestDay == 0 ? 0 : Math.Clamp((int)(earnings / BestDay * 100), 2, 100);
}
