@page "/"
@implements IDisposable
@inject ApiClient Api

<div class="topbar">
    <div>
        <div class="topbar__mark">Fast<b>Ride</b> Driver</div>
        <div class="topbar__greet">@FirstName</div>
    </div>
    <div class="topbar__spacer"></div>
    @if (_home is not null)
    {
        <span class="@(_home.IsOnline ? "pill pill--go" : "pill pill--idle")">
            @(_home.IsOnline ? "Aktif" : "Nonaktif")
        </span>
    }
</div>

<div class="screen">
    @if (_message is not null)
    {
        <div class="alert @(_messageIsError ? "alert--error" : "alert--ok")" role="alert">@_message</div>
    }

    @if (_loading)
    {
        <div class="hero stack">
            <div class="skeleton" style="width:40%"></div>
            <div class="skeleton" style="height:32px"></div>
        </div>
    }
    else if (_home is null)
    {
        <div class="alert alert--error">Tidak bisa terhubung ke server FastRide.</div>
        <button class="btn" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i><span>Coba lagi</span></button>
    }
    else if (!_home.IsDocumentVerified)
    {
        @* A driver whose papers are not approved cannot go online at all, so say that first. *@
        <div class="hero">
            <span class="hero__label">Akun belum aktif</span>
            <div class="hero__value">Menunggu verifikasi</div>
            <span class="small muted">
                Unggah SIM, STNK, dan KTP lalu tunggu persetujuan admin sebelum bisa menerima order.
            </span>
            <a class="btn btn--primary" href="/documents">
                <i class="bi bi-file-earmark-arrow-up"></i><span>Kelola dokumen</span>
            </a>
        </div>
    }
    else if (_home.ActiveTrip is { } trip)
    {
        <div class="hero">
            <span class="hero__label">Perjalanan berjalan · @trip.Code</span>
            <div class="row">
                <span class="@Display.PillClass(trip.Status)">@Display.Label(trip.Status)</span>
                <span class="spacer money">@Display.Rupiah(trip.FinalFare)</span>
            </div>

            <div class="route">
                <div class="route__stop">
                    <i class="bi bi-circle go"></i>
                    <div><strong class="truncate">@trip.PickupAddress</strong><small>Jemput @trip.Rider.FullName</small></div>
                </div>
                @foreach (var stop in trip.Stops)
                {
                    <div class="route__stop">
                        <i class="bi bi-dot dim"></i>
                        <div><strong class="truncate">@stop.Address</strong><small>Singgah @stop.SequenceNumber</small></div>
                    </div>
                }
                <div class="route__stop">
                    <i class="bi bi-geo-alt stop"></i>
                    <div><strong class="truncate">@trip.DropoffAddress</strong><small>Tujuan</small></div>
                </div>
            </div>

            @* One button, one next step — no guessing which action applies right now. *@
            <button class="btn btn--go" @onclick="() => AdvanceAsync(trip)" disabled="@_busy">
                <i class="bi bi-arrow-right-circle"></i><span>@NextActionLabel(trip.Status)</span>
            </button>

            <button class="btn btn--danger" @onclick="() => CancelAsync(trip.Id)" disabled="@_busy">
                <i class="bi bi-x-octagon"></i><span>Batalkan</span>
            </button>
        </div>
    }
    else
    {
        <div class="hero">
            <span class="hero__label">Pendapatan hari ini</span>
            <div class="hero__value">@Display.Rupiah(_home.TodayEarnings)</div>
            <span class="small muted">@_home.TodayTrips trip selesai · rating @_home.Rating.ToString("0.0")</span>

            <button class="btn @(_home.IsOnline ? "btn--danger" : "btn--go")" @onclick="ToggleAsync" disabled="@_busy">
                <i class="bi @(_home.IsOnline ? "bi-pause-circle" : "bi-play-circle")"></i>
                <span>@(_home.IsOnline ? "Berhenti terima order" : "Mulai terima order")</span>
            </button>
        </div>

        <div class="metrics metrics--3">
            <div class="metric"><span>Trip hari ini</span><b>@_home.TodayTrips</b></div>
            <div class="metric"><span>Rating</span><b>@_home.Rating.ToString("0.0")</b></div>
            <div class="metric"><span>Order masuk</span><b>@_home.IncomingOrders.Count</b></div>
        </div>

        <div class="card card--flush">
            <div class="card__head">
                <h2>Order tersedia</h2>
                <button class="btn btn--sm btn--ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i></button>
            </div>

            @if (!_home.IsOnline)
            {
                <div class="empty">
                    <i class="bi bi-pause-circle"></i>
                    <strong>Kamu sedang nonaktif</strong>
                    <span>Aktifkan status untuk melihat order di sekitarmu.</span>
                </div>
            }
            else if (_home.IncomingOrders.Count == 0)
            {
                <div class="empty">
                    <i class="bi bi-hourglass-split"></i>
                    <strong>Belum ada order di sekitarmu</strong>
                    <span>Order baru akan muncul otomatis di sini.</span>
                </div>
            }
            else
            {
                <div class="rows">
                    @foreach (var offer in _home.IncomingOrders)
                    {
                        <div class="row-item">
                            <div class="row-item__body">
                                <strong class="truncate">@offer.PickupAddress</strong>
                                <small class="truncate">→ @offer.DropoffAddress</small>
                                <small>
                                    @Display.Distance(offer.PickupDistanceKm) dari kamu ·
                                    trip @Display.Distance(offer.DistanceKm) ·
                                    @Display.Label(offer.PaymentMethod)
                                </small>
                            </div>
                            <div class="row-item__end stack stack--tight">
                                <div class="money">@Display.RupiahShort(offer.EstimatedFare)</div>
                                <button class="btn btn--sm btn--go" @onclick="() => AcceptAsync(offer.OrderId)" disabled="@_busy">
                                    Ambil
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (_home?.RecentTrips.Count > 0)
    {
        <div class="card card--flush">
            <div class="card__head"><h2>Trip terakhir</h2></div>
            <div class="rows">
                @foreach (var trip in _home.RecentTrips.Take(5))
                {
                    <div class="row-item">
                        <div class="row-item__body">
                            <strong class="truncate">@trip.DropoffAddress</strong>
                            <small>@Display.DateTimeShort(trip.CreatedAt) · @trip.DriverName</small>
                        </div>
                        <div class="row-item__end money small">@Display.Rupiah(trip.Fare)</div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private DriverHomeResponse? _home;
    private bool _loading = true, _busy;
    private string? _message;
    private bool _messageIsError;
    private Timer? _timer;

    private string FirstName =>
        Api.CurrentUserName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Driver";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        _timer = new Timer(async _ => await InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(8), TimeSpan.FromSeconds(8));
    }

    private async Task LoadAsync()
    {
        _home = await Api.GetHomeAsync();
        _loading = false;
    }

    private static string NextActionLabel(OrderStatus status) => status switch
    {
        OrderStatus.Accepted => "Sudah tiba di titik jemput",
        OrderStatus.DriverArrived => "Mulai perjalanan",
        OrderStatus.Started => "Selesaikan perjalanan",
        _ => "Lanjutkan"
    };

    private async Task AdvanceAsync(OrderDetailResponse trip)
    {
        _busy = true;

        var error = trip.Status switch
        {
            OrderStatus.Accepted => await Api.ArriveOrderAsync(trip.Id),
            OrderStatus.DriverArrived => await Api.StartOrderAsync(trip.Id),
            OrderStatus.Started => await Api.CompleteOrderAsync(trip.Id),
            _ => "Status perjalanan tidak bisa dilanjutkan."
        };

        _busy = false;
        _messageIsError = error is not null;
        _message = error ?? "Status perjalanan diperbarui.";

        await LoadAsync();
    }

    private async Task AcceptAsync(Guid orderId)
    {
        _busy = true;
        var error = await Api.AcceptOrderAsync(orderId);
        _busy = false;

        _messageIsError = error is not null;
        _message = error ?? "Order diambil. Menuju titik jemput.";

        await LoadAsync();
    }

    private async Task CancelAsync(Guid orderId)
    {
        _busy = true;
        var error = await Api.CancelOrderAsync(orderId, "Dibatalkan driver");
        _busy = false;

        _messageIsError = error is not null;
        _message = error ?? "Perjalanan dibatalkan.";

        await LoadAsync();
    }

    private async Task ToggleAsync()
    {
        if (_home is null) return;

        _busy = true;
        var (status, error) = await Api.SetStatusAsync(_home.IsOnline ? DriverStatus.Offline : DriverStatus.Online);
        _busy = false;

        _messageIsError = error is not null;
        _message = error ?? (status == DriverStatus.Online
            ? "Kamu aktif. Order akan mulai masuk."
            : "Kamu nonaktif. Tidak ada order baru yang masuk.");

        await LoadAsync();
    }

    public void Dispose() => _timer?.Dispose();
}
