@page "/profile"
@inject ApiClient Api

<div class="topbar">
    <div class="topbar__mark">Profil</div>
</div>

<div class="screen">
    @if (_loading)
    {
        <div class="card stack">
            <div class="skeleton" style="height:66px;width:66px;border-radius:50%"></div>
            <div class="skeleton" style="width:60%"></div>
        </div>
    }
    else if (_profile is null)
    {
        <div class="alert alert--error">Tidak bisa memuat profil. Periksa koneksi ke server.</div>
    }
    else
    {
        <div class="card stack center">
            <img class="avatar avatar--lg" style="margin:0 auto;"
                 src="@Display.Avatar(_profile.PhotoUrl, _profile.FullName)" alt="" />
            <div>
                <strong>@_profile.FullName</strong>
                <div class="small muted">@_profile.Email</div>
            </div>
            @if (_profile.Driver is { } driver)
            {
                <span class="@Display.PillClass(driver.Status)" style="justify-self:center;">
                    @Display.Label(driver.Status)
                </span>
            }
        </div>

        @if (_profile.Driver is { } stats)
        {
            <div class="metrics metrics--3">
                <div class="metric"><span>Trip</span><b>@stats.TotalTrips</b></div>
                <div class="metric"><span>Rating</span><b>@stats.Rating.ToString("0.0")</b></div>
                <div class="metric"><span>Pendapatan</span><b>@Display.RupiahShort(stats.TotalEarnings)</b></div>
            </div>
        }

        @if (_message is not null)
        {
            <div class="alert @(_messageIsError ? "alert--error" : "alert--ok")">@_message</div>
        }

        <div class="card stack">
            <strong>Data diri</strong>
            <div class="field">
                <label for="name">Nama lengkap</label>
                <input id="name" @bind="_fullName" @bind:event="oninput" />
            </div>
            <div class="field">
                <label for="phone">Nomor telepon</label>
                <input id="phone" type="tel" @bind="_phone" @bind:event="oninput" />
            </div>
            <button class="btn btn--primary" @onclick="SaveProfileAsync" disabled="@_busy">
                <i class="bi bi-check2"></i><span>Simpan data diri</span>
            </button>
        </div>

        <div class="card stack">
            <strong>Kendaraan</strong>
            <div class="field">
                <label for="license">Nomor SIM</label>
                <input id="license" @bind="_license" @bind:event="oninput" />
            </div>
            <div class="field">
                <label for="vehicle">Kendaraan</label>
                <input id="vehicle" @bind="_vehicleType" @bind:event="oninput" placeholder="Toyota Avanza" />
            </div>
            <div class="field">
                <label for="plate">Nomor polisi</label>
                <input id="plate" @bind="_plate" @bind:event="oninput" placeholder="B 1234 XYZ" />
            </div>
            <div class="field">
                <label for="category">Kategori layanan</label>
                <select id="category" @bind="SelectedCategory">
                    @foreach (var category in Enum.GetValues<VehicleCategory>())
                    {
                        <option value="@category">@Display.Label(category)</option>
                    }
                </select>
            </div>
            <button class="btn btn--primary" @onclick="SaveVehicleAsync" disabled="@_busy">
                <i class="bi bi-check2"></i><span>Simpan kendaraan</span>
            </button>
        </div>

        <button class="btn btn--danger" @onclick="LogoutAsync">
            <i class="bi bi-box-arrow-right"></i><span>Keluar</span>
        </button>
    }
</div>

@code {
    private UserProfileResponse? _profile;
    private string _fullName = string.Empty;
    private string _phone = string.Empty;
    private string _license = string.Empty;
    private string _vehicleType = string.Empty;
    private string _plate = string.Empty;
    private VehicleCategory _category = VehicleCategory.Economy;
    private bool _loading = true, _busy;
    private string? _message;
    private bool _messageIsError;

    private string SelectedCategory
    {
        get => _category.ToString();
        set => _category = Enum.Parse<VehicleCategory>(value);
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _profile = await Api.GetProfileAsync();
        _loading = false;

        if (_profile is null) return;

        _fullName = _profile.FullName;
        _phone = _profile.PhoneNumber;

        if (_profile.Driver is { } driver)
        {
            _license = driver.LicenseNumber;
            _vehicleType = driver.VehicleType;
            _plate = driver.VehiclePlate;
            _category = driver.VehicleCategory;
        }
    }

    private async Task SaveProfileAsync()
    {
        _busy = true;
        var error = await Api.UpdateProfileAsync(_fullName.Trim(), _phone.Trim());
        _busy = false;

        _messageIsError = error is not null;
        _message = error ?? "Data diri tersimpan.";

        if (error is null) await LoadAsync();
    }

    private async Task SaveVehicleAsync()
    {
        _busy = true;
        var error = await Api.UpdateVehicleAsync(_license.Trim(), _vehicleType.Trim(), _plate.Trim(), _category);
        _busy = false;

        _messageIsError = error is not null;
        _message = error ?? "Data kendaraan tersimpan.";

        if (error is null) await LoadAsync();
    }

    private async Task LogoutAsync() => await Api.LogoutAsync();
}
