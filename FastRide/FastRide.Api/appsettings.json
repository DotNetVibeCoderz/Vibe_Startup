{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "FastRide": "Information"
    }
  },
  "AllowedHosts": "*",
  "Urls": "https://localhost:5001;http://localhost:5000",

  "Database": {
    "Provider": "SQLite",
    "AutoSeed": true,
    "ConnectionStrings": {
      "SQLite": "Data Source=FastRide.db",
      "SqlServer": "Server=.;Database=FastRide;Trusted_Connection=true;TrustServerCertificate=true",
      "PostgreSQL": "Host=localhost;Database=FastRide;Username=postgres;Password=postgres",
      "MySQL": "Server=localhost;Database=FastRide;User Id=root;Password=root"
    }
  },

  "Cache": {
    "Provider": "Memory",
    "Redis": {
      "ConnectionString": "localhost:6379",
      "InstanceName": "fastride:"
    }
  },

  "Storage": {
    "Provider": "FileSystem",
    "FileSystem": {
      "Path": "uploads",
      "BaseUrl": "/uploads"
    },
    "S3": {
      "Endpoint": "http://localhost:9000",
      "Bucket": "fastride-photos",
      "AccessKey": "minioadmin",
      "SecretKey": "minioadmin",
      "Region": "us-east-1",
      "PublicUrl": "http://localhost:9000/fastride-photos"
    },
    "Azure": {
      "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=fastride;AccountKey=REPLACE_ME;EndpointSuffix=core.windows.net",
      "Container": "fastride-photos"
    }
  },

  "Jwt": {
    "Secret": "FastRide-Development-Only-Secret-Key-Change-Me-32+",
    "Issuer": "FastRide",
    "Audience": "FastRide",
    "AccessTokenExpirationMinutes": 1440
  },

  "RateLimiting": {
    "// AuthPermitPerMinute": "Per klien. Cukup ketat untuk menghambat tebak sandi, cukup longgar agar simulator bisa menyiapkan aktornya.",
    "AuthPermitPerMinute": 30,
    "GlobalPermitPerMinute": 600,
    "// WebhookPermitPerMinute": "Callback provider datang tanpa token, jadi punya jatah sendiri. Harus longgar agar retry sah tidak ditolak.",
    "WebhookPermitPerMinute": 600
  },

  "Payments": {
    "// Providers": "Disalin ke database saat start pertama, lalu bisa diubah dari konsol admin. Baris di database menang atas berkas ini.",
    "// Kredensial": "JANGAN taruh key produksi di sini. Pakai variabel lingkungan (Payments__Providers__2__ServerKey) atau isi lewat konsol admin.",
    "Providers": [
      {
        "Name": "manual",
        "DisplayName": "Tunai / manual",
        "Enabled": true,
        "Sandbox": false,
        "Priority": 10,
        "Methods": [ "Cash" ]
      },
      {
        "Name": "simulated",
        "DisplayName": "Simulasi (sandbox)",
        "Enabled": true,
        "Sandbox": true,
        "Priority": 20,
        "Methods": [ "Qris", "EWallet", "CreditCard", "VirtualAccount", "BankTransfer" ],
        "WebhookSecret": "fastride-sandbox-webhook-secret",
        "MerchantId": "ID1234567890123",
        "MerchantName": "FASTRIDE SANDBOX",
        "MerchantCity": "JAKARTA",
        "ChargeExpiryMinutes": 15
      },
      {
        "Name": "midtrans",
        "DisplayName": "Midtrans",
        "Enabled": false,
        "Sandbox": true,
        "Priority": 30,
        "Methods": [ "Qris", "EWallet", "CreditCard", "VirtualAccount" ],
        "ServerKey": "",
        "ClientKey": "",
        "WebhookSecret": "",
        "ChargeExpiryMinutes": 15
      },
      {
        "Name": "xendit",
        "DisplayName": "Xendit",
        "Enabled": false,
        "Sandbox": true,
        "Priority": 40,
        "Methods": [ "Qris", "EWallet", "VirtualAccount" ],
        "ServerKey": "",
        "WebhookSecret": "",
        "ChargeExpiryMinutes": 15
      }
    ]
  },

  "ApiSettings": {
    "BaseUrl": "https://localhost:5001",
    "CorsOrigins": [
      "https://localhost:5002",
      "http://localhost:5003"
    ]
  }
}
