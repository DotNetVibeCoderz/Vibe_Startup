{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "FastRide.Api": {
      "commandName": "Project",
      "launchBrowser": false,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "// note": "Must match ApiSettings:BaseUrl and every client's configured API URL. The launch profile overrides the Urls key in appsettings.json, so a mismatch here silently breaks AdminWeb, both MAUI apps and the simulator.",
      "applicationUrl": "https://localhost:5001;http://localhost:5000"
    },
    "FastRide.Api (http only)": {
      "commandName": "Project",
      "launchBrowser": false,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "applicationUrl": "http://localhost:5000"
    }
  }
}
