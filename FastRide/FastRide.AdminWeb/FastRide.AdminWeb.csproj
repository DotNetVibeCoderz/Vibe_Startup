<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The console talks to the API over HTTP only. It deliberately does not reference
         FastRide.Data: a second process holding the same DbContext would bypass every rule
         the API enforces. -->
    <ProjectReference Include="..\FastRide.Shared\FastRide.Shared.csproj" />
  </ItemGroup>

</Project>
