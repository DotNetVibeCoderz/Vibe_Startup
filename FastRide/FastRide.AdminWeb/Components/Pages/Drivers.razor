@page "/drivers"
@inject ApiClient Api

<PageTitle>Driver · FastRide</PageTitle>

<div class="page-head">
    <div>
        <h1>Driver</h1>
        <p>Armada, status terkini, dan performa.</p>
    </div>
    <button class="btn btn--ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i><span>Segarkan</span></button>
</div>

<section class="panel">
    <div class="panel__body">
        <div class="filters">
            <div class="field field--grow">
                <label for="search">Cari</label>
                <input id="search" placeholder="Nama, email, atau nomor polisi"
                       @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKey" />
            </div>
            <div class="field">
                <label for="status">Status</label>
                <select id="status" @bind="SelectedStatus">
                    <option value="">Semua status</option>
                    @foreach (var status in Enum.GetValues<DriverStatus>())
                    {
                        <option value="@status">@Display.Label(status)</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="verified">Verifikasi</label>
                <select id="verified" @bind="SelectedVerified">
                    <option value="">Semua</option>
                    <option value="true">Terverifikasi</option>
                    <option value="false">Belum terverifikasi</option>
                </select>
            </div>
            <button class="btn btn--primary" @onclick="ApplyFilters"><i class="bi bi-funnel"></i><span>Terapkan</span></button>
        </div>
    </div>
</section>

<section class="panel mt">
    @if (_loading)
    {
        <div class="panel__body stack stack--tight">
            @for (var i = 0; i < 8; i++)
            {
                <div class="skeleton"></div>
            }
        </div>
    }
    else if (_result.Total == 0)
    {
        <EmptyState Icon="bi-car-front" Title="Tidak ada driver yang cocok"
                    Hint="Coba ubah kata kunci atau filter status." />
    }
    else
    {
        <div class="table-wrap">
            <table class="grid-table">
                <thead>
                    <tr>
                        <th>Driver</th>
                        <th>Kendaraan</th>
                        <th>Status</th>
                        <th class="right">Rating</th>
                        <th class="right">Trip</th>
                        <th class="right">Pendapatan</th>
                        <th>Sinyal GPS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var driver in _result.Data)
                    {
                        <tr>
                            <td>
                                <div class="person">
                                    <img src="@Display.Avatar(driver.PhotoUrl, driver.FullName)" alt="" />
                                    <div>
                                        <strong>@driver.FullName</strong>
                                        <small>@driver.Email</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @driver.VehicleType
                                <div class="code">@driver.VehiclePlate · @driver.VehicleCategory</div>
                            </td>
                            <td>
                                <span class="@Display.PillClass(driver.Status)">@Display.Label(driver.Status)</span>
                                @if (!driver.IsDocumentVerified)
                                {
                                    <div class="dim" style="font-size:.72rem;margin-top:3px;">
                                        <i class="bi bi-exclamation-triangle"></i> Dokumen belum lengkap
                                    </div>
                                }
                            </td>
                            <td class="right num">@driver.Rating.ToString("0.0")</td>
                            <td class="right num">@Display.Number(driver.TotalTrips)</td>
                            <td class="right money">@Display.Rupiah(driver.TotalEarnings)</td>
                            <td class="dim nowrap">
                                @if (driver.LocationUpdatedAt is null)
                                {
                                    <span>Belum pernah</span>
                                }
                                else
                                {
                                    <span class="@(IsStale(driver.LocationUpdatedAt.Value) ? "stop" : "")">
                                        @Display.Since(driver.LocationUpdatedAt.Value)
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <Pager TItem="DriverListItem" Result="_result" OnPageChanged="GoToPageAsync" />
    }
</section>

@code {
    private PagedResult<DriverListItem> _result = new();
    private string _search = string.Empty;
    private DriverStatus? _status;
    private bool? _verified;
    private int _page = 1;
    private bool _loading = true;

    private string SelectedStatus
    {
        get => _status?.ToString() ?? string.Empty;
        set => _status = Enum.TryParse<DriverStatus>(value, out var status) ? status : null;
    }

    private string SelectedVerified
    {
        get => _verified?.ToString().ToLowerInvariant() ?? string.Empty;
        set => _verified = bool.TryParse(value, out var flag) ? flag : null;
    }

    /// <summary>Matches the dispatcher's freshness window — a stale ping means the driver is not matchable.</summary>
    private static bool IsStale(DateTime lastPing) => DateTime.UtcNow - lastPing > TimeSpan.FromMinutes(10);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _result = await Api.GetDriversAsync(_page, 20, _search, _status, _verified);
        _loading = false;
    }

    private async Task ApplyFilters()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task OnSearchKey(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await ApplyFilters();
    }

    private async Task GoToPageAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }
}
