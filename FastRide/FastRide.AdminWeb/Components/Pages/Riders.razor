@page "/riders"
@inject ApiClient Api

<PageTitle>Penumpang · FastRide</PageTitle>

<div class="page-head">
    <div>
        <h1>Penumpang</h1>
        <p>Daftar penumpang beserta riwayat pemakaian.</p>
    </div>
    <button class="btn btn--ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i><span>Segarkan</span></button>
</div>

<section class="panel">
    <div class="panel__body">
        <div class="filters">
            <div class="field field--grow">
                <label for="search">Cari</label>
                <input id="search" placeholder="Nama, email, atau nomor telepon"
                       @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKey" />
            </div>
            <button class="btn btn--primary" @onclick="ApplyFilters"><i class="bi bi-search"></i><span>Cari</span></button>
        </div>
    </div>
</section>

<section class="panel mt">
    @if (_loading)
    {
        <div class="panel__body stack stack--tight">
            @for (var i = 0; i < 8; i++)
            {
                <div class="skeleton"></div>
            }
        </div>
    }
    else if (_result.Total == 0)
    {
        <EmptyState Icon="bi-person-walking" Title="Tidak ada penumpang yang cocok"
                    Hint="Coba kata kunci lain." />
    }
    else
    {
        <div class="table-wrap">
            <table class="grid-table">
                <thead>
                    <tr>
                        <th>Penumpang</th>
                        <th>Telepon</th>
                        <th>Status</th>
                        <th class="right">Trip selesai</th>
                        <th class="right">Total belanja</th>
                        <th>Bergabung</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rider in _result.Data)
                    {
                        <tr>
                            <td>
                                <div class="person">
                                    <img src="@Display.Avatar(rider.PhotoUrl, rider.FullName)" alt="" />
                                    <div>
                                        <strong>@rider.FullName</strong>
                                        <small>@rider.Email</small>
                                    </div>
                                </div>
                            </td>
                            <td class="num">@rider.PhoneNumber</td>
                            <td>
                                @if (!rider.IsActive)
                                {
                                    <span class="pill pill--stop">Nonaktif</span>
                                }
                                else if (rider.IsVerified)
                                {
                                    <span class="pill pill--go">Terverifikasi</span>
                                }
                                else
                                {
                                    <span class="pill pill--wait">Belum verifikasi</span>
                                }
                            </td>
                            <td class="right num">@Display.Number(rider.TotalTrips)</td>
                            <td class="right money">@Display.Rupiah(rider.TotalSpent)</td>
                            <td class="dim nowrap">@Display.Date(rider.CreatedAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <Pager TItem="RiderListItem" Result="_result" OnPageChanged="GoToPageAsync" />
    }
</section>

@code {
    private PagedResult<RiderListItem> _result = new();
    private string _search = string.Empty;
    private int _page = 1;
    private bool _loading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _result = await Api.GetRidersAsync(_page, 20, _search);
        _loading = false;
    }

    private async Task ApplyFilters()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task OnSearchKey(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await ApplyFilters();
    }

    private async Task GoToPageAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }
}
