@page "/"
@implements IAsyncDisposable
@inject ApiClient Api
@inject IJSRuntime JS

<PageTitle>Ringkasan · FastRide</PageTitle>

<div class="page-head">
    <div>
        <h1>Ringkasan</h1>
        <p>
            @if (_overview is null)
            {
                <span>Memuat data operasi…</span>
            }
            else
            {
                <span>Diperbarui @Display.Clock(_overview.Stats.Timestamp) · menyegar sendiri tiap 15 detik</span>
            }
        </p>
    </div>
    <button class="btn btn--ghost" @onclick="LoadAsync" disabled="@_loading">
        <i class="bi bi-arrow-clockwise"></i><span>Segarkan</span>
    </button>
</div>

@if (_error is not null)
{
    <div class="alert alert--error" role="alert">@_error</div>
}

@if (_overview is null)
{
    <div class="grid grid--4">
        @for (var i = 0; i < 4; i++)
        {
            <div class="tile">
                <div class="skeleton" style="width:60%"></div>
                <div class="skeleton" style="height:28px"></div>
            </div>
        }
    </div>
}
else
{
    <div class="grid grid--4">
        <StatTile Label="Order hari ini"
                  Value="@Display.Number(_overview.Stats.TotalOrdersToday)"
                  Note="@($"{_overview.Stats.CompletionRatePercent:0.#}% selesai · {_overview.Stats.CancellationRatePercent:0.#}% batal")" />

        <StatTile Label="Pendapatan hari ini"
                  Value="@Display.RupiahShort(_overview.Stats.RevenueToday)"
                  Tone="go"
                  Note="@($"Rata-rata {Display.Rupiah(_overview.Stats.AverageFare)} per trip")" />

        <StatTile Label="Driver aktif"
                  Value="@Display.Number(_overview.Stats.ActiveDrivers)"
                  Tone="move"
                  Note="@($"{_overview.Stats.OnlineDrivers} siap menerima order")" />

        <StatTile Label="Order menunggu"
                  Value="@Display.Number(_overview.Stats.PendingOrders)"
                  Tone="@(_overview.Stats.PendingOrders > 10 ? "stop" : "wait")"
                  Note="@(_overview.Stats.PendingOrders > 10 ? "Antrian menumpuk — cek ketersediaan driver" : "Antrian normal")" />
    </div>

    <div class="grid grid--main mt">
        <section class="panel">
            <div class="panel__head">
                <h2>Pendapatan 30 hari</h2>
                <span class="dim">Bulan ini @Display.Rupiah(_overview.Stats.RevenueMonth)</span>
            </div>
            <div class="panel__body">
                <div class="chart-box chart-box--tall"><canvas id="chart-revenue"></canvas></div>
            </div>
        </section>

        <section class="panel">
            <div class="panel__head"><h2>Status order</h2></div>
            <div class="panel__body">
                <div class="chart-box"><canvas id="chart-status"></canvas></div>
            </div>
        </section>
    </div>

    <div class="grid grid--main mt">
        <section class="panel">
            <div class="panel__head">
                <h2>Ritme hari ini</h2>
                <span class="dim">Puncak @PeakHourLabel · sekarang @NowHourLabel</span>
            </div>
            <div class="panel__body">
                @* Drawn as a road: bars stand on a lane line, the current hour is lit jade and
                   the busiest hour amber. Reading it needs no legend. *@
                <div class="trafficband">
                    @foreach (var hour in _overview.Hourly)
                    {
                        <div class="trafficband__bar"
                             style="height:@(BarHeight(hour.Count))%"
                             data-peak="@Flag(hour.Hour == PeakHour && hour.Count > 0)"
                             data-now="@Flag(hour.Hour == DateTime.Now.Hour)"
                             title="@($"{hour.Hour:00}.00 — {hour.Count} order · {Display.Rupiah(hour.Revenue)}")"></div>
                    }
                </div>
                <div class="trafficband__axis">
                    @foreach (var hour in _overview.Hourly)
                    {
                        <span>@(hour.Hour % 3 == 0 ? hour.Hour.ToString("00") : "")</span>
                    }
                </div>
            </div>
        </section>

        <section class="panel">
            <div class="panel__head"><h2>Kategori kendaraan</h2></div>
            <div class="panel__body">
                <div class="chart-box"><canvas id="chart-category"></canvas></div>
            </div>
        </section>
    </div>

    <div class="grid grid--main mt">
        <section class="panel">
            <div class="panel__head">
                <h2>Driver terbaik 30 hari</h2>
                <a href="/drivers" class="dim">Semua driver →</a>
            </div>
            @if (_overview.TopDrivers.Count == 0)
            {
                <EmptyState Icon="bi-car-front" Title="Belum ada trip selesai bulan ini"
                            Hint="Jalankan FastRide.Simulator untuk menghasilkan lalu lintas order." />
            }
            else
            {
                <div class="table-wrap">
                    <table class="grid-table">
                        <thead>
                            <tr>
                                <th>Driver</th>
                                <th>Kendaraan</th>
                                <th class="right">Trip</th>
                                <th class="right">Rating</th>
                                <th class="right">Pendapatan</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var driver in _overview.TopDrivers)
                            {
                                <tr>
                                    <td>
                                        <div class="person">
                                            <img src="@Display.Avatar(driver.PhotoUrl, driver.FullName)" alt="" />
                                            <div><strong>@driver.FullName</strong></div>
                                        </div>
                                    </td>
                                    <td class="muted">@driver.VehicleType</td>
                                    <td class="right num">@driver.Trips</td>
                                    <td class="right num">@driver.Rating.ToString("0.0")</td>
                                    <td class="right money">@Display.Rupiah(driver.Earnings)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="panel">
            <div class="panel__head"><h2>Metode pembayaran</h2></div>
            <div class="panel__body">
                @if (_overview.PaymentMethods.Count == 0)
                {
                    <EmptyState Icon="bi-wallet2" Title="Belum ada pembayaran"
                                Hint="Data muncul setelah ada trip yang selesai." />
                }
                else
                {
                    <div class="chart-box"><canvas id="chart-payment"></canvas></div>
                }
            </div>
        </section>
    </div>
}

@code {
    private DashboardOverviewResponse? _overview;
    private string? _error;
    private bool _loading;
    private Timer? _timer;

    private int MaxHourly => _overview is { Hourly.Count: > 0 } ? _overview.Hourly.Max(h => h.Count) : 0;

    private int PeakHour => _overview is { Hourly.Count: > 0 }
        ? _overview.Hourly.OrderByDescending(h => h.Count).First().Hour
        : 0;

    private string PeakHourLabel => $"{PeakHour:00}.00";
    private string NowHourLabel => $"{DateTime.Now.Hour:00}.00";

    private int BarHeight(int count) => MaxHourly == 0 ? 2 : Math.Max(2, (int)(count * 100.0 / MaxHourly));

    /// <summary>Blazor drops a false bool attribute entirely, so the CSS selector needs a literal string.</summary>
    private static string Flag(bool value) => value ? "true" : "false";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        _timer = new Timer(async _ => await InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_overview is not null) await DrawChartsAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        _overview = await Api.GetOverviewAsync();
        if (_overview is null) _error = "Tidak bisa memuat data. Pastikan FastRide.Api sedang berjalan.";

        _loading = false;
    }

    private async Task DrawChartsAsync()
    {
        if (_overview is null) return;

        try
        {
            await JS.InvokeVoidAsync("fastride.revenueSeries", "chart-revenue",
                _overview.RevenueSeries.Select(p => p.Date.ToString("dd/MM")).ToArray(),
                _overview.RevenueSeries.Select(p => p.Revenue).ToArray(),
                _overview.RevenueSeries.Select(p => p.Orders).ToArray());

            // Statuses with no orders would only add noise to the legend.
            var statuses = _overview.ByStatus.Where(s => s.Count > 0).ToList();
            await JS.InvokeVoidAsync("fastride.statusDoughnut", "chart-status",
                statuses.Select(s => Display.Label(s.Status)).ToArray(),
                statuses.Select(s => s.Count).ToArray(),
                statuses.Select(s => Display.ChartColour(s.Status)).ToArray());

            await JS.InvokeVoidAsync("fastride.categoryBars", "chart-category",
                _overview.Categories.Select(c => c.VehicleCategory.ToString()).ToArray(),
                _overview.Categories.Select(c => c.Orders).ToArray());

            if (_overview.PaymentMethods.Count > 0)
            {
                await JS.InvokeVoidAsync("fastride.paymentBars", "chart-payment",
                    _overview.PaymentMethods.Select(p => Display.Label(p.Method)).ToArray(),
                    _overview.PaymentMethods.Select(p => p.Amount).ToArray());
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit went away mid-render; nothing left to draw on.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();

        try
        {
            foreach (var id in new[] { "chart-revenue", "chart-status", "chart-category", "chart-payment" })
                await JS.InvokeVoidAsync("fastride.dispose", id);
        }
        catch (JSDisconnectedException)
        {
            // Circuit already closed.
        }
    }
}
