@page "/book"
@inject ApiClient Api
@inject NavigationManager Nav

<div class="topbar">
    <div class="topbar__mark">Pesan</div>
    <div class="topbar__spacer"></div>
    @if (_quote is not null)
    {
        <span class="money">@Display.Rupiah(_quote.FinalFare)</span>
    }
</div>

<div class="screen">
    @if (_error is not null)
    {
        <div class="alert alert--error" role="alert">@_error</div>
    }

    <div class="card stack">
        <div class="field">
            <label for="pickup">Titik jemput</label>
            <input id="pickup" @bind="_pickup" @bind:event="oninput" placeholder="Jl. Sudirman No. 1" />
        </div>
        <div class="field">
            <label for="dropoff">Tujuan</label>
            <input id="dropoff" @bind="_dropoff" @bind:event="oninput" placeholder="Jl. Thamrin No. 9" />
        </div>

        @if (_stopAddress is not null)
        {
            <div class="field">
                <label for="stop">Singgah</label>
                <div class="row">
                    <input id="stop" @bind="_stopAddress" @bind:event="oninput" placeholder="Alamat singgah" />
                    <button class="btn btn--sm btn--ghost" @onclick="RemoveStop" title="Hapus singgah">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
        }
        else
        {
            <button class="btn btn--ghost btn--sm" @onclick="AddStop">
                <i class="bi bi-plus"></i><span>Tambah titik singgah</span>
            </button>
        }
    </div>

    <div class="stack stack--tight">
        <span class="dim small" style="text-transform:uppercase;letter-spacing:.14em;">Kendaraan</span>
        <div class="choices">
            @foreach (var category in Categories)
            {
                <div class="choice @(_category == category ? "selected" : "")"
                     role="button" tabindex="0" @onclick="() => SelectAsync(category)">
                    <i class="@Display.Icon(category)"></i>
                    <small>@Display.Label(category)</small>
                    <b>@PriceFor(category)</b>
                </div>
            }
        </div>
    </div>

    <div class="card stack">
        <div class="field">
            <label for="payment">Pembayaran</label>
            <select id="payment" @bind="SelectedPayment">
                @foreach (var method in Enum.GetValues<PaymentMethod>())
                {
                    <option value="@method">@Display.Label(method)</option>
                }
            </select>
        </div>

        <div class="field">
            <label for="promo">Kode promo</label>
            <div class="row">
                <input id="promo" @bind="_promo" @bind:event="oninput" placeholder="WELCOME50" />
                <button class="btn btn--sm" @onclick="RefreshQuoteAsync" disabled="@_quoting">Pakai</button>
            </div>
        </div>

        @if (_quote?.PromoMessage is { Length: > 0 } message)
        {
            <div class="alert @(_quote.Discount > 0 ? "alert--ok" : "alert--warn")">@message</div>
        }
    </div>

    @* The estimate comes from the API's own fare table, so it matches what will be charged. *@
    <div class="hero">
        <span class="hero__label">Perkiraan biaya</span>
        @if (_quoting)
        {
            <div class="row"><span class="spinner"></span><span class="muted">Menghitung…</span></div>
        }
        else if (_quote is null)
        {
            <div class="hero__value">—</div>
            <span class="small muted">Isi titik jemput dan tujuan untuk melihat harga.</span>
        }
        else
        {
            <div class="hero__value">@Display.Rupiah(_quote.FinalFare)</div>
            <span class="small muted">
                @Display.Distance(_quote.DistanceKm) · ± @_quote.EstimatedDurationMinutes menit
                @if (_quote.Discount > 0)
                {
                    <text> · hemat @Display.Rupiah(_quote.Discount)</text>
                }
            </span>
            @if (_quote.SurgeMultiplier > 1)
            {
                <span class="pill pill--wait">Tarif sibuk ×@_quote.SurgeMultiplier.ToString("0.0")</span>
            }
        }
    </div>

    <button class="btn btn--primary" @onclick="BookAsync" disabled="@(_booking || _quote is null)">
        @if (_booking)
        {
            <span class="spinner"></span>
            <span>Memesan</span>
        }
        else
        {
            <i class="bi bi-car-front-fill"></i>
            <span>Pesan sekarang</span>
        }
    </button>
</div>

@code {
    // Jakarta reference points; a production build would read these from the device's GPS.
    private const double PickupLat = -6.2088, PickupLon = 106.8456;
    private const double DropoffLat = -6.1751, DropoffLon = 106.8650;
    private const double StopLat = -6.1900, StopLon = 106.8500;

    private static readonly VehicleCategory[] Categories = Enum.GetValues<VehicleCategory>();

    private string _pickup = "Jl. Sudirman No. 1";
    private string _dropoff = "Jl. Thamrin No. 9";
    private string? _stopAddress;
    private string _promo = string.Empty;
    private VehicleCategory _category = VehicleCategory.Economy;
    private PaymentMethod _payment = PaymentMethod.Cash;

    private FareQuoteResponse? _quote;
    private readonly Dictionary<VehicleCategory, decimal> _prices = new();
    private bool _quoting, _booking;
    private string? _error;

    private string SelectedPayment
    {
        get => _payment.ToString();
        set => _payment = Enum.Parse<PaymentMethod>(value);
    }

    protected override Task OnInitializedAsync() => RefreshAllPricesAsync();

    private string PriceFor(VehicleCategory category) =>
        _prices.TryGetValue(category, out var price) ? Display.RupiahShort(price) : "—";

    private async Task SelectAsync(VehicleCategory category)
    {
        _category = category;
        await RefreshQuoteAsync();
    }

    private void AddStop() => _stopAddress = string.Empty;

    private async Task RemoveStop()
    {
        _stopAddress = null;
        await RefreshAllPricesAsync();
    }

    private List<TripStopRequest>? Stops() =>
        string.IsNullOrWhiteSpace(_stopAddress)
            ? null
            : [new TripStopRequest(StopLat, StopLon, _stopAddress)];

    /// <summary>Price every category once so the chooser shows real numbers, not guesses.</summary>
    private async Task RefreshAllPricesAsync()
    {
        _quoting = true;

        foreach (var category in Categories)
        {
            var quote = await Api.QuoteAsync(new FareQuoteRequest(
                PickupLat, PickupLon, DropoffLat, DropoffLon, category, null, Stops()));

            if (quote is not null) _prices[category] = quote.FinalFare;
        }

        _quoting = false;
        await RefreshQuoteAsync();
    }

    private async Task RefreshQuoteAsync()
    {
        _quoting = true;
        _error = null;

        _quote = await Api.QuoteAsync(new FareQuoteRequest(
            PickupLat, PickupLon, DropoffLat, DropoffLon, _category,
            string.IsNullOrWhiteSpace(_promo) ? null : _promo.Trim(), Stops()));

        if (_quote is null) _error = "Tidak bisa menghitung tarif. Periksa koneksi ke server.";

        _quoting = false;
    }

    private async Task BookAsync()
    {
        if (string.IsNullOrWhiteSpace(_pickup) || string.IsNullOrWhiteSpace(_dropoff))
        {
            _error = "Isi titik jemput dan tujuan dulu.";
            return;
        }

        _booking = true;
        _error = null;

        var (order, error) = await Api.BookAsync(new CreateOrderRequest(
            Api.CurrentUserId,
            PickupLat, PickupLon, _pickup,
            DropoffLat, DropoffLon, _dropoff,
            _category, _payment,
            string.IsNullOrWhiteSpace(_promo) ? null : _promo.Trim(),
            Stops()));

        _booking = false;

        if (order is null)
        {
            _error = error;
            return;
        }

        Nav.NavigateTo($"/track/{order.Id}");
    }
}
