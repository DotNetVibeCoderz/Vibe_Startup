@page "/trips"
@inject ApiClient Api
@inject NavigationManager Nav

<div class="topbar">
    <div class="topbar__mark">Riwayat</div>
    <div class="topbar__spacer"></div>
    <span class="dim small num">@_result.Total perjalanan</span>
</div>

<div class="screen">
    @if (_loading)
    {
        <div class="card card--flush">
            @for (var i = 0; i < 6; i++)
            {
                <div class="row-item"><div class="skeleton" style="width:100%"></div></div>
            }
        </div>
    }
    else if (_result.Total == 0)
    {
        <div class="card">
            <div class="empty">
                <i class="bi bi-signpost"></i>
                <strong>Belum ada perjalanan</strong>
                <span>Pesan perjalanan pertamamu dari tab Pesan.</span>
            </div>
            <button class="btn btn--primary" @onclick="OpenBooking">
                <i class="bi bi-car-front-fill"></i><span>Pesan sekarang</span>
            </button>
        </div>
    }
    else
    {
        <div class="card card--flush">
            <div class="rows">
                @foreach (var trip in _result.Data)
                {
                    <div class="row-item" role="button" @onclick="() => OpenTrip(trip.Id)">
                        <div class="row-item__body">
                            <strong class="truncate">@trip.DropoffAddress</strong>
                            <small class="truncate">
                                @trip.Code · @Display.DateTimeShort(trip.CreatedAt) · @(trip.DriverName ?? "Tanpa driver")
                            </small>
                        </div>
                        <div class="row-item__end">
                            <div class="money small">@Display.Rupiah(trip.FinalFare)</div>
                            <span class="@Display.PillClass(trip.Status)">@Display.Label(trip.Status)</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (_result.TotalPages > 1)
        {
            <div class="btn-row">
                <button class="btn btn--ghost" disabled="@(!_result.HasPrevious)" @onclick="() => GoAsync(_result.Page - 1)">
                    <i class="bi bi-chevron-left"></i><span>Sebelumnya</span>
                </button>
                <button class="btn btn--ghost" disabled="@(!_result.HasNext)" @onclick="() => GoAsync(_result.Page + 1)">
                    <span>Berikutnya</span><i class="bi bi-chevron-right"></i>
                </button>
            </div>
        }
    }
</div>

@code {
    private PagedResult<OrderListItem> _result = new();
    private bool _loading = true;

    private void OpenTrip(Guid orderId) => Nav.NavigateTo($"/track/{orderId}");
    private void OpenBooking() => Nav.NavigateTo("/book");

    protected override Task OnInitializedAsync() => GoAsync(1);

    private async Task GoAsync(int page)
    {
        _loading = true;
        _result = await Api.GetTripsAsync(page);
        _loading = false;
    }
}
