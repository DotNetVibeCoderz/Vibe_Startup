@page "/"
@implements IDisposable
@inject ApiClient Api
@inject NavigationManager Nav

<div class="topbar">
    <div>
        <div class="topbar__mark">Fast<b>Ride</b></div>
        <div class="topbar__greet">Halo, @FirstName</div>
    </div>
    <div class="topbar__spacer"></div>
    @if (_home?.UnreadNotifications > 0)
    {
        <span class="pill pill--wait">@_home.UnreadNotifications baru</span>
    }
</div>

<div class="screen">
    @if (_loading)
    {
        <div class="hero stack">
            <div class="skeleton" style="width:40%"></div>
            <div class="skeleton" style="height:32px"></div>
        </div>
        <div class="metrics">
            <div class="metric"><div class="skeleton"></div></div>
            <div class="metric"><div class="skeleton"></div></div>
        </div>
    }
    else if (_home is null)
    {
        <div class="alert alert--error">
            Tidak bisa terhubung ke server FastRide. Pastikan API berjalan, lalu tarik untuk memuat ulang.
        </div>
        <button class="btn" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i><span>Coba lagi</span></button>
    }
    else if (_home.ActiveOrder is { } active)
    {
        @* When a trip is running, it *is* the screen — nothing else competes with it. *@
        <div class="hero">
            <span class="hero__label">Perjalanan berjalan · @active.Code</span>
            <div class="row">
                <span class="@Display.PillClass(active.Status)">@Display.Label(active.Status)</span>
                <span class="spacer money">@Display.Rupiah(active.FinalFare)</span>
            </div>

            <TripProgress Status="active.Status" />

            <div class="route">
                <div class="route__stop">
                    <i class="bi bi-circle go"></i>
                    <div><strong class="truncate">@active.PickupAddress</strong><small>Titik jemput</small></div>
                </div>
                <div class="route__stop">
                    <i class="bi bi-geo-alt stop"></i>
                    <div><strong class="truncate">@active.DropoffAddress</strong><small>Tujuan</small></div>
                </div>
            </div>

            <button class="btn btn--primary" @onclick="() => OpenTrip(active.Id)">
                <i class="bi bi-broadcast"></i><span>Lacak perjalanan</span>
            </button>
        </div>
    }
    else
    {
        <div class="hero">
            <span class="hero__label">Mau ke mana hari ini?</span>
            <div class="hero__value">@Display.Rupiah(_home.TotalSpent)</div>
            <span class="small muted">Total belanja dari @_home.TotalTrips perjalanan</span>
            <button class="btn btn--primary" @onclick="OpenBooking">
                <i class="bi bi-car-front-fill"></i><span>Pesan perjalanan</span>
            </button>
        </div>

        <div class="metrics">
            <div class="metric"><span>Perjalanan</span><b>@_home.TotalTrips</b></div>
            <div class="metric"><span>Total belanja</span><b>@Display.RupiahShort(_home.TotalSpent)</b></div>
        </div>
    }

    @if (_home is not null)
    {
        <div class="card card--flush">
            <div class="card__head">
                <h2>Perjalanan terakhir</h2>
                <a href="/trips" class="small">Semua →</a>
            </div>

            @if (_home.RecentTrips.Count == 0)
            {
                <div class="empty">
                    <i class="bi bi-signpost"></i>
                    <strong>Belum ada perjalanan</strong>
                    <span>Pesanan pertama kamu akan muncul di sini.</span>
                </div>
            }
            else
            {
                <div class="rows">
                    @foreach (var trip in _home.RecentTrips.Take(6))
                    {
                        <div class="row-item" role="button" @onclick="() => OpenTrip(trip.OrderId)">
                            <div class="row-item__body">
                                <strong class="truncate">@trip.DropoffAddress</strong>
                                <small>@Display.DateTimeShort(trip.CreatedAt) · @(trip.DriverName ?? "Tanpa driver")</small>
                            </div>
                            <div class="row-item__end">
                                <div class="money small">@Display.Rupiah(trip.Fare)</div>
                                <span class="@Display.PillClass(trip.Status)">@Display.Label(trip.Status)</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private RiderHomeResponse? _home;
    private bool _loading = true;
    private Timer? _timer;

    private string FirstName =>
        Api.CurrentUserName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Penumpang";

    // Navigation goes through methods: an interpolated string inside a Razor attribute
    // would nest double quotes and fail to parse.
    private void OpenTrip(Guid orderId) => Nav.NavigateTo($"/track/{orderId}");
    private void OpenBooking() => Nav.NavigateTo("/book");

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        // While a trip is live the status changes underneath the rider; poll so the card keeps up.
        _timer = new Timer(async _ => await InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    private async Task LoadAsync()
    {
        _home = await Api.GetHomeAsync();
        _loading = false;
    }

    public void Dispose() => _timer?.Dispose();
}
