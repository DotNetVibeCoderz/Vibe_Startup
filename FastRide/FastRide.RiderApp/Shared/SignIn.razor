@inject ApiClient Api

<div class="gate">
    <form class="gate__card" @onsubmit="Submit" @onsubmit:preventDefault>
        <div>
            <div class="gate__mark">Fast<b>Ride</b></div>
            <p class="dim small" style="margin:2px 0 0;letter-spacing:.16em;text-transform:uppercase;">
                @(_mode == Mode.SignIn ? "Masuk penumpang" : "Daftar penumpang")
            </p>
        </div>

        @if (_error is not null)
        {
            <div class="alert alert--error" role="alert">@_error</div>
        }

        @if (_mode == Mode.Register)
        {
            <div class="field">
                <label for="name">Nama lengkap</label>
                <input id="name" @bind="_fullName" @bind:event="oninput" placeholder="Budi Santoso" />
            </div>
            <div class="field">
                <label for="phone">Nomor telepon</label>
                <input id="phone" type="tel" @bind="_phone" @bind:event="oninput" placeholder="08123456789" />
            </div>
        }

        <div class="field">
            <label for="email">Email</label>
            <input id="email" type="email" inputmode="email" autocomplete="username"
                   @bind="_email" @bind:event="oninput" placeholder="nama@email.com" />
        </div>

        <div class="field">
            <label for="password">Kata sandi</label>
            <input id="password" type="password" autocomplete="current-password"
                   @bind="_password" @bind:event="oninput" placeholder="••••••••" />
        </div>

        <button class="btn btn--primary" type="submit" disabled="@_busy">
            @if (_busy)
            {
                <span class="spinner"></span>
                <span>Memproses</span>
            }
            else
            {
                <i class="bi bi-arrow-right-circle"></i>
                <span>@(_mode == Mode.SignIn ? "Masuk" : "Buat akun")</span>
            }
        </button>

        <button class="btn btn--ghost" type="button" @onclick="ToggleMode">
            @(_mode == Mode.SignIn ? "Belum punya akun? Daftar" : "Sudah punya akun? Masuk")
        </button>

        @if (_mode == Mode.SignIn)
        {
            <div class="gate__hint">
                Akun demo: <code>budi.santoso@email.com</code> · <code>Password123</code>
            </div>
        }
    </form>
</div>

@code {
    [Parameter] public EventCallback OnSignedIn { get; set; }

    private enum Mode { SignIn, Register }

    private Mode _mode = Mode.SignIn;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _fullName = string.Empty;
    private string _phone = string.Empty;
    private string? _error;
    private bool _busy;

    private void ToggleMode()
    {
        _mode = _mode == Mode.SignIn ? Mode.Register : Mode.SignIn;
        _error = null;
    }

    private async Task Submit()
    {
        if (_busy) return;
        _error = null;

        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _error = "Isi email dan kata sandi dulu.";
            return;
        }

        if (_mode == Mode.Register && (string.IsNullOrWhiteSpace(_fullName) || string.IsNullOrWhiteSpace(_phone)))
        {
            _error = "Nama dan nomor telepon wajib diisi.";
            return;
        }

        if (_mode == Mode.Register && _password.Length < 8)
        {
            _error = "Kata sandi minimal 8 karakter.";
            return;
        }

        _busy = true;

        var (success, error) = _mode == Mode.SignIn
            ? await Api.LoginAsync(_email.Trim(), _password)
            : await Api.RegisterAsync(_fullName.Trim(), _email.Trim(), _phone.Trim(), _password);

        _busy = false;

        if (!success)
        {
            _error = error;
            return;
        }

        await OnSignedIn.InvokeAsync();
    }
}
