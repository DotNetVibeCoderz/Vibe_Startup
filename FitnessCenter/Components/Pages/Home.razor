@page "/"
@attribute [Authorize]
@inject MemberService MemberService
@inject AttendanceService AttendanceService
@inject PaymentService PaymentService
@inject ClassService ClassService
@inject GamificationService GamificationService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthState
@inject AppDbContext Db

@if (isLoading)
{
    <div class="grid-4 mb-3">
        @for (var i = 0; i < 4; i++)
        {
            <div class="stat-card">
                <span class="stat-label skeleton" style="width:7rem;">&nbsp;</span>
                <span class="stat-value skeleton" style="width:5rem;">&nbsp;</span>
            </div>
        }
    </div>
    <div class="brutal-card" style="height:16rem;"><span class="skeleton" style="display:block;height:100%;">&nbsp;</span></div>
}
else if (isStaffView)
{
    @* ---------------- Panel lantai: pemandangan utama untuk admin & staf ---------------- *@
    <section class="floor-panel mb-3">
        <div class="floor-main">
            <div class="floor-eyebrow">@todayLabel · pukul @nowWib.ToString("HH:mm") WIB</div>
            <div class="floor-count">
                <span data-countup="@Inv(todayCheckins)">@todayCheckins.ToString("N0")</span>
                <span class="floor-count-unit">orang</span>
            </div>
            <div class="floor-caption">check-in hari ini</div>

            <div class="load-meter" data-meter="@busyPercent" style="--plate:var(--plate-yellow);">
                @for (var i = 0; i < 12; i++) { <i></i> }
            </div>
            <div class="floor-hint">
                @if (peakCheckins > 0)
                {
                    <text>@busyPercent% dari hari tersibuk 30 hari terakhir (@peakCheckins orang)</text>
                }
                else
                {
                    <text>Belum ada riwayat check-in untuk dibandingkan</text>
                }
            </div>
        </div>

        <div class="floor-side">
            <a href="/attendance" class="floor-tile">
                <span class="floor-tile-value">@classesToday</span>
                <span class="floor-tile-label">Kelas terjadwal hari ini</span>
            </a>
            <a href="/payments" class="floor-tile">
                <span class="floor-tile-value" style="color:@(pendingInvoices > 0 ? "var(--plate-yellow)" : "inherit");">@pendingInvoices</span>
                <span class="floor-tile-label">Invoice menunggu bayar</span>
            </a>
            <a href="/members" class="floor-tile">
                <span class="floor-tile-value">@activeMembers</span>
                <span class="floor-tile-label">Membership masih aktif</span>
            </a>
        </div>
    </section>

    <div class="grid-4 mb-3" data-stagger>
        <div class="stat-card plate-blue">
            <span class="stat-label">Total member</span>
            <span class="stat-value" data-countup="@Inv(totalMembers)">@totalMembers.ToString("N0")</span>
            <div class="stat-foot">@retentionRate% masih bertahan</div>
        </div>
        <div class="stat-card plate-green">
            <span class="stat-label">Member aktif</span>
            <span class="stat-value" data-countup="@Inv(activeMembers)">@activeMembers.ToString("N0")</span>
            <div class="stat-foot">dari @totalMembers terdaftar</div>
        </div>
        <div class="stat-card plate-yellow">
            <span class="stat-label">Pendapatan 30 hari</span>
            <span class="stat-value" data-countup="@Inv(monthlyRevenue)" data-prefix="Rp ">Rp @monthlyRevenue.ToString("N0")</span>
            <div class="stat-foot">@completedThisMonth pembayaran lunas</div>
        </div>
        <div class="stat-card plate-violet">
            <span class="stat-label">Kelas berjalan</span>
            <span class="stat-value" data-countup="@Inv(totalClasses)">@totalClasses.ToString("N0")</span>
            <div class="stat-foot">@classesToday jadwal hari ini</div>
        </div>
    </div>

    <div class="grid-2 mb-3">
        <div class="brutal-card plate-green" style="padding:0;">
            <div class="card-head" style="padding:var(--sp-5) var(--sp-5) 0;margin-bottom:var(--sp-3);">
                <h4>Pembayaran terakhir</h4>
                <a href="/payments" class="brutal-btn brutal-btn-ghost brutal-btn-sm">Lihat semua</a>
            </div>
            @if (recentPayments.Any())
            {
                <div style="overflow-x:auto;">
                    <table class="brutal-table">
                        <thead><tr><th>Invoice</th><th>Member</th><th>Nominal</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var p in recentPayments)
                            {
                                <tr>
                                    <td class="mono">@p.InvoiceNumber</td>
                                    <td>@p.User?.FullName</td>
                                    <td><strong>Rp @p.Amount.ToString("N0")</strong></td>
                                    <td><span class="brutal-badge @StatusTone(p.Status)">@p.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">🧾</div>
                    <h4>Belum ada pembayaran</h4>
                    <p class="text-sm">Buat tagihan bulanan dari halaman Payments.</p>
                    <a href="/payments" class="brutal-btn brutal-btn-sm mt-1">Buka Payments</a>
                </div>
            }
        </div>

        <div class="brutal-card plate-yellow" style="padding:0;">
            <div class="card-head" style="padding:var(--sp-5) var(--sp-5) 0;margin-bottom:var(--sp-3);">
                <h4>Papan peringkat</h4>
                <a href="/leaderboard" class="brutal-btn brutal-btn-ghost brutal-btn-sm">Lihat semua</a>
            </div>
            @if (leaderboard.Any())
            {
                <div style="overflow-x:auto;">
                    <table class="brutal-table">
                        <thead><tr><th>Peringkat</th><th>Member</th><th>Poin</th></tr></thead>
                        <tbody>
                            @foreach (var l in leaderboard)
                            {
                                <tr>
                                    <td>@RankMark(l.Rank)</td>
                                    <td>@l.UserName</td>
                                    <td><strong>@l.TotalPoints.ToString("N0")</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">🏆</div>
                    <h4>Papan peringkat masih kosong</h4>
                    <p class="text-sm">Poin terkumpul otomatis dari check-in dan kelas.</p>
                </div>
            }
        </div>
    </div>

    <div class="brutal-card plate-blue">
        <h4 class="mb-2">Aksi cepat</h4>
        <div class="flex gap-1 flex-wrap">
            <a href="/attendance" class="brutal-btn">Catat check-in</a>
            <a href="/members" class="brutal-btn brutal-btn-outline">Kelola member</a>
            <a href="/classes" class="brutal-btn brutal-btn-outline">Atur jadwal kelas</a>
            <a href="/payments" class="brutal-btn brutal-btn-outline">Tagihan &amp; pembayaran</a>
            <a href="/chatbot" class="brutal-btn brutal-btn-outline">Tanya Coach Tommy</a>
        </div>
    </div>
}
else
{
    @* ---------------- Pemandangan member: kemajuan pribadi ---------------- *@
    <section class="floor-panel mb-3">
        <div class="floor-main">
            <div class="floor-eyebrow">@Greeting(), @(currentUser?.FullName?.Split(' ')[0] ?? "Member")</div>
            <div class="floor-count">
                <span data-countup="@Inv(streakDays)">@streakDays</span>
                <span class="floor-count-unit">hari</span>
            </div>
            <div class="floor-caption">runtutan check-in berjalan</div>

            <div class="load-meter" data-meter="@Math.Min(streakDays * 100 / 7, 100)" style="--plate:var(--plate-green);">
                @for (var i = 0; i < 7; i++) { <i></i> }
            </div>
            <div class="floor-hint">
                @if (streakDays >= 7) { <text>Satu minggu penuh. Pertahankan.</text> }
                else if (streakDays > 0) { <text>@(7 - streakDays) hari lagi menuju runtutan satu minggu</text> }
                else { <text>Check-in hari ini untuk memulai runtutan baru</text> }
            </div>
        </div>

        <div class="floor-side">
            <a href="/leaderboard" class="floor-tile">
                <span class="floor-tile-value">@(currentUser?.LoyaltyPoints.ToString("N0") ?? "0")</span>
                <span class="floor-tile-label">Poin loyalitas</span>
            </a>
            <a href="/memberships" class="floor-tile">
                <span class="floor-tile-value" style="color:@(daysLeft.HasValue && daysLeft < 7 ? "var(--plate-red)" : "inherit");">
                    @(daysLeft.HasValue ? daysLeft.Value.ToString() : "—")
                </span>
                <span class="floor-tile-label">Sisa hari membership</span>
            </a>
            <a href="/payments" class="floor-tile">
                <span class="floor-tile-value" style="color:@(myPendingCount > 0 ? "var(--plate-yellow)" : "inherit");">@myPendingCount</span>
                <span class="floor-tile-label">Tagihan belum dibayar</span>
            </a>
        </div>
    </section>

    @if (myPendingCount > 0)
    {
        <div class="notice notice-warn mb-3">
            <span>💳</span>
            <div>
                <strong>@myPendingCount tagihan menunggu pembayaran</strong>
                <div class="text-sm text-muted">Total Rp @myPendingAmount.ToString("N0")</div>
            </div>
            <a href="/payments" class="brutal-btn brutal-btn-sm" style="margin-left:auto;">Bayar sekarang</a>
        </div>
    }

    <div class="grid-2 mb-3">
        <div class="brutal-card plate-blue">
            <div class="card-head">
                <h4>Kelas hari ini</h4>
                <a href="/classes" class="brutal-btn brutal-btn-ghost brutal-btn-sm">Jadwal lengkap</a>
            </div>
            @if (todaySchedule.Any())
            {
                <div class="schedule-list">
                    @foreach (var s in todaySchedule)
                    {
                        <div class="schedule-row">
                            <span class="mono schedule-time">@s.StartTime.ToString(@"hh\:mm")</span>
                            <div style="min-width:0;">
                                <div style="font-weight:600;">@s.FitnessClass?.Name</div>
                                <div class="text-sm text-muted">
                                    @s.FitnessClass?.Trainer?.FullName · @s.FitnessClass?.Room
                                </div>
                            </div>
                            <span class="brutal-badge" style="margin-left:auto;">
                                @s.CurrentBookings/@(s.FitnessClass?.MaxParticipants ?? 0)
                            </span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">📅</div>
                    <h4>Tidak ada kelas hari ini</h4>
                    <p class="text-sm">Lihat jadwal minggu ini untuk merencanakan latihan.</p>
                    <a href="/classes" class="brutal-btn brutal-btn-sm mt-1">Lihat jadwal</a>
                </div>
            }
        </div>

        <div class="brutal-card plate-yellow">
            <div class="card-head">
                <h4>Papan peringkat</h4>
                <a href="/leaderboard" class="brutal-btn brutal-btn-ghost brutal-btn-sm">Lihat semua</a>
            </div>
            @if (leaderboard.Any())
            {
                <div class="schedule-list">
                    @foreach (var l in leaderboard)
                    {
                        <div class="schedule-row @(l.UserName == currentUser?.FullName ? "is-me" : "")">
                            <span class="schedule-time">@RankMark(l.Rank)</span>
                            <div style="font-weight:@(l.UserName == currentUser?.FullName ? "700" : "500");">@l.UserName</div>
                            <strong style="margin-left:auto;">@l.TotalPoints.ToString("N0")</strong>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">🏆</div>
                    <h4>Papan peringkat masih kosong</h4>
                </div>
            }
        </div>
    </div>

    <div class="brutal-card plate-green">
        <h4 class="mb-2">Aksi cepat</h4>
        <div class="flex gap-1 flex-wrap">
            <a href="/attendance" class="brutal-btn">Check-in</a>
            <a href="/classes" class="brutal-btn brutal-btn-outline">Booking kelas</a>
            <a href="/workout" class="brutal-btn brutal-btn-outline">Catat latihan</a>
            <a href="/nutrition" class="brutal-btn brutal-btn-outline">Rencana nutrisi</a>
            <a href="/chatbot" class="brutal-btn brutal-btn-outline">Tanya Coach Tommy</a>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isStaffView;
    private ApplicationUser? currentUser;

    // Ringkasan operasional
    private int totalMembers, activeMembers, todayCheckins, totalClasses, classesToday;
    private int pendingInvoices, completedThisMonth, peakCheckins, busyPercent;
    private decimal monthlyRevenue, retentionRate;
    private List<Payment> recentPayments = new();

    // Ringkasan member
    private int streakDays, myPendingCount;
    private decimal myPendingAmount;
    private int? daysLeft;
    private List<ClassSchedule> todaySchedule = new();

    private List<LeaderboardEntry> leaderboard = new();

    private DateTime nowWib = DateTime.UtcNow.AddHours(7);
    private string todayLabel = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthState.GetAuthenticationStateAsync();
            currentUser = await UserManager.GetUserAsync(authState.User);
            isStaffView = currentUser?.Role is UserRole.Admin or UserRole.Staff;

            nowWib = DateTime.UtcNow.AddHours(7);
            todayLabel = nowWib.ToString("dddd, d MMMM yyyy", new CultureInfo("id-ID"));

            leaderboard = await GamificationService.GetLeaderboardAsync(5);

            if (isStaffView) await LoadStaffAsync();
            else await LoadMemberAsync();
        }
        catch { /* dashboard tetap tampil walau salah satu query gagal */ }
        finally { isLoading = false; }
    }

    private async Task LoadStaffAsync()
    {
        var monthAgo = DateTime.UtcNow.AddMonths(-1);

        totalMembers = await MemberService.GetTotalMembersAsync();
        activeMembers = await MemberService.GetActiveMembersAsync();
        todayCheckins = await AttendanceService.GetTodayCheckInsAsync();
        monthlyRevenue = await PaymentService.GetTotalRevenueAsync(monthAgo);
        retentionRate = await MemberService.GetRetentionRateAsync();
        totalClasses = (await ClassService.GetAllAsync()).Count;
        classesToday = (await ClassService.GetScheduleAsync(DateTime.UtcNow)).Count(s => !s.IsCancelled);

        pendingInvoices = await Db.Payments.CountAsync(p => p.Status == PaymentStatus.Pending);
        completedThisMonth = await Db.Payments.CountAsync(p => p.Status == PaymentStatus.Completed && p.PaidAt >= monthAgo);

        recentPayments = await Db.Payments.Include(p => p.User)
            .OrderByDescending(p => p.CreatedAt).Take(5).ToListAsync();

        // Hari tersibuk 30 hari terakhir jadi pembanding kepadatan lantai
        var since = DateTime.UtcNow.Date.AddDays(-30);
        var byDay = await Db.Attendances
            .Where(a => a.Type == AttendanceType.CheckIn && a.Timestamp >= since)
            .GroupBy(a => a.Timestamp.Date)
            .Select(g => g.Count())
            .ToListAsync();

        peakCheckins = byDay.Any() ? byDay.Max() : 0;
        busyPercent = peakCheckins > 0 ? (int)Math.Round(Math.Min(todayCheckins * 100.0 / peakCheckins, 100)) : 0;
    }

    private async Task LoadMemberAsync()
    {
        if (currentUser == null) return;

        streakDays = await AttendanceService.GetStreakDaysAsync(currentUser.Id);

        if (currentUser.MembershipExpiryDate.HasValue)
        {
            var remaining = (currentUser.MembershipExpiryDate.Value.Date - DateTime.UtcNow.Date).Days;
            daysLeft = Math.Max(remaining, 0);
        }

        var pending = await Db.Payments
            .Where(p => p.UserId == currentUser.Id && p.Status == PaymentStatus.Pending)
            .ToListAsync();
        myPendingCount = pending.Count;
        myPendingAmount = pending.Sum(p => p.Amount);

        todaySchedule = (await ClassService.GetScheduleAsync(DateTime.UtcNow))
            .Where(s => !s.IsCancelled)
            .Take(6)
            .ToList();
    }

    private string Greeting()
    {
        var h = DateTime.UtcNow.AddHours(7).Hour;
        return h < 11 ? "Selamat pagi" : h < 15 ? "Selamat siang" : h < 18 ? "Selamat sore" : "Selamat malam";
    }

    /// <summary>
    /// Angka untuk data-countup ditulis dalam format invariant supaya JavaScript
    /// bisa membacanya apa pun culture server. Teks yang tampil tetap diformat lokal,
    /// jadi nilainya sudah benar meski JavaScript gagal dimuat.
    /// </summary>
    private static string Inv(decimal value) => value.ToString(CultureInfo.InvariantCulture);
    private static string Inv(int value) => value.ToString(CultureInfo.InvariantCulture);

    private static string RankMark(int rank) => rank switch
    {
        1 => "🥇", 2 => "🥈", 3 => "🥉", _ => $"#{rank}"
    };

    private static string StatusTone(PaymentStatus s) => s switch
    {
        PaymentStatus.Pending => "brutal-badge-accent",
        PaymentStatus.Confirmed => "brutal-badge-info",
        PaymentStatus.Completed => "brutal-badge-success",
        PaymentStatus.Refunded => "brutal-badge-purple",
        PaymentStatus.Failed or PaymentStatus.Cancelled => "brutal-badge-danger",
        _ => ""
    };
}
