@page "/register"
@layout FitnessCenter.Components.Layout.MinimalLayout
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

<div class="auth-split">

    <aside class="auth-brand">
        <div class="auth-brand-top">
            <div class="auth-logo">🏋️ Fitness<br />Center</div>
        </div>

        <div class="auth-brand-mid">
            <h1 class="auth-statement">Mulai dari<br />satu langkah<br />ke lantai gym.</h1>
            <p class="auth-sub">Daftar sekali, lalu booking kelas, catat latihan, dan bayar membership dari satu akun.</p>
        </div>

        <ul class="auth-plates">
            <li><span style="--tone:var(--plate-red);"></span> Booking kelas tanpa antre</li>
            <li><span style="--tone:var(--plate-blue);"></span> Bayar lewat e-wallet atau transfer</li>
            <li><span style="--tone:var(--plate-yellow);"></span> Kumpulkan poin tiap check-in</li>
            <li><span style="--tone:var(--plate-green);"></span> Rencana latihan &amp; nutrisi pribadi</li>
        </ul>
    </aside>

    <main class="auth-panel">
        <div class="auth-form" style="max-width:32rem;">
            <h2 class="mb-1">Buat akun</h2>
            <p class="text-muted mb-3">Kolom bertanda * wajib diisi.</p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="notice notice-danger mb-3" role="alert">
                    <span>⚠️</span>
                    <div>@errorMessage</div>
                </div>
            }
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="notice notice-success mb-3" role="status">
                    <span>✅</span>
                    <div>@successMessage</div>
                </div>
            }

            <EditForm Model="regModel" OnValidSubmit="HandleRegister" FormName="registerForm">
                <DataAnnotationsValidator />

                <div class="grid-2" style="gap:var(--sp-3);">
                    <div class="field">
                        <label for="fullName">Nama lengkap *</label>
                        <InputText id="fullName" @bind-Value="regModel.FullName" class="brutal-input" placeholder="Sesuai KTP" />
                    </div>
                    <div class="field">
                        <label for="regEmail">Email *</label>
                        <InputText id="regEmail" @bind-Value="regModel.Email" class="brutal-input" type="email" placeholder="nama@email.com" />
                    </div>
                    <div class="field">
                        <label for="phone">Nomor HP</label>
                        <InputText id="phone" @bind-Value="regModel.Phone" class="brutal-input" placeholder="08xxxxxxxxxx" />
                    </div>
                    <div class="field">
                        <label for="gender">Jenis kelamin</label>
                        <select id="gender" class="brutal-select" @bind="regModel.Gender">
                            <option value="Male">Laki-laki</option>
                            <option value="Female">Perempuan</option>
                            <option value="Other">Lainnya</option>
                        </select>
                    </div>
                    <div class="field">
                        <label for="pwd">Password *</label>
                        <InputText id="pwd" @bind-Value="regModel.Password" type="password" class="brutal-input" placeholder="Minimal 8 karakter" />
                    </div>
                    <div class="field">
                        <label for="pwd2">Ulangi password *</label>
                        <InputText id="pwd2" @bind-Value="regModel.ConfirmPassword" type="password" class="brutal-input" />
                    </div>
                </div>

                <div class="field">
                    <label for="address">Alamat</label>
                    <InputText id="address" @bind-Value="regModel.Address" class="brutal-input" />
                </div>
                <div class="field">
                    <label for="ktp">Nomor KTP</label>
                    <InputText id="ktp" @bind-Value="regModel.KtpNumber" class="brutal-input" />
                    <span class="field-hint">Dipakai untuk verifikasi keanggotaan di resepsionis.</span>
                </div>

                <ValidationSummary class="text-sm" style="color:var(--plate-red);" />

                <button type="submit" class="brutal-btn brutal-btn-lg brutal-btn-block mt-2" disabled="@isLoading">
                    @(isLoading ? "Membuat akun…" : "Buat akun")
                </button>
            </EditForm>

            <p class="mt-3 text-sm">
                Sudah punya akun? <a href="/login">Masuk di sini</a>
            </p>
        </div>
    </main>
</div>

@code {
    private RegisterModel regModel = new();
    private bool isLoading;
    private string errorMessage = "";
    private string successMessage = "";

    public class RegisterModel
    {
        [Required(ErrorMessage = "Full name is required")]
        public string FullName { get; set; } = "";

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Password is required")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Confirm password")]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = "";

        public string Phone { get; set; } = "";
        public string Gender { get; set; } = "Male";
        public string Address { get; set; } = "";
        public string KtpNumber { get; set; } = "";
    }

    private async Task HandleRegister()
    {
        isLoading = true; errorMessage = ""; successMessage = "";
        try
        {
            var user = new ApplicationUser
            {
                UserName = regModel.Email,
                Email = regModel.Email,
                FullName = regModel.FullName,
                PhoneNumber = regModel.Phone,
                Gender = Enum.TryParse<Gender>(regModel.Gender, out var g) ? g : Gender.Male,
                Address = regModel.Address,
                KtpNumber = regModel.KtpNumber,
                RegisteredAt = DateTime.UtcNow,
                IsActive = true,
                Role = UserRole.Member,
                EmailConfirmed = true
            };

            var result = await UserManager.CreateAsync(user, regModel.Password);
            if (result.Succeeded)
            {
                await UserManager.AddToRoleAsync(user, "Member");
                successMessage = "Registration successful! Redirecting to login...";
                await Task.Delay(2000);
                Navigation.NavigateTo("/login");
            }
            else
            {
                errorMessage = string.Join("; ", result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { isLoading = false; }
    }
}
