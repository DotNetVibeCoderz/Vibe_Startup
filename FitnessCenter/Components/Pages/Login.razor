@page "/login"
@layout FitnessCenter.Components.Layout.MinimalLayout
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<div class="auth-split">

    @* Sisi kiri: papan identitas, memakai warna plate sebagai penanda *@
    <aside class="auth-brand">
        <div class="auth-brand-top">
            <div class="auth-logo">🏋️ Fitness<br />Center</div>
        </div>

        <div class="auth-brand-mid">
            <h1 class="auth-statement">Satu tempat<br />untuk seluruh<br />lantai gym.</h1>
            <p class="auth-sub">Member, kelas, absensi, dan pembayaran — dikelola dari satu layar.</p>
        </div>

        <ul class="auth-plates">
            <li><span style="--tone:var(--plate-red);"></span> Absensi &amp; kelas harian</li>
            <li><span style="--tone:var(--plate-blue);"></span> Tagihan &amp; pembayaran online</li>
            <li><span style="--tone:var(--plate-yellow);"></span> Poin, lencana, papan peringkat</li>
            <li><span style="--tone:var(--plate-green);"></span> Coach Tommy siap menjawab</li>
        </ul>
    </aside>

    @* Sisi kanan: formulir *@
    <main class="auth-panel">
        <div class="auth-form">
            <h2 class="mb-1">Masuk</h2>
            <p class="text-muted mb-3">Gunakan email yang terdaftar di fitness center.</p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="notice notice-danger mb-3" role="alert">
                    <span>⚠️</span>
                    <div>@errorMessage</div>
                </div>
            }

            <form method="post" action="/login" id="loginForm">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <div class="field">
                    <label for="email">Email</label>
                    <input id="email" name="email" type="email" class="brutal-input"
                           placeholder="nama@email.com" autocomplete="username" required autofocus />
                </div>

                <div class="field">
                    <label for="password">Password</label>
                    <input id="password" name="password" type="password" class="brutal-input"
                           placeholder="Minimal 8 karakter" autocomplete="current-password" required />
                </div>

                <button type="submit" class="brutal-btn brutal-btn-lg brutal-btn-block">Masuk</button>
            </form>

            <div class="flex justify-between mt-3 text-sm">
                <a href="/register">Buat akun baru</a>
                <a href="/reset-password" class="text-muted">Lupa password?</a>
            </div>

            <div class="demo-block">
                <div class="eyebrow mb-1">Akun demo — klik untuk mengisi</div>
                <div class="flex gap-1 flex-wrap">
                    <button type="button" class="brutal-btn brutal-btn-outline brutal-btn-sm"
                            onclick="fillLogin('admin@fitnesscenter.com','Admin123!')">Admin</button>
                    <button type="button" class="brutal-btn brutal-btn-outline brutal-btn-sm"
                            onclick="fillLogin('trainer1@fitnesscenter.com','Trainer123!')">Trainer</button>
                    <button type="button" class="brutal-btn brutal-btn-outline brutal-btn-sm"
                            onclick="fillLogin('member1@email.com','Member123!')">Member</button>
                    <button type="button" class="brutal-btn brutal-btn-outline brutal-btn-sm"
                            onclick="fillLogin('staff1@fitnesscenter.com','Staff123!')">Staff</button>
                </div>
            </div>
        </div>
    </main>
</div>

<script suppress-error="BL9992">
    function fillLogin(email, password) {
        var e = document.getElementById('email');
        var p = document.getElementById('password');
        if (!e || !p) return;
        e.value = email;
        p.value = password;
        p.focus();
        [e, p].forEach(function (el) {
            el.animate(
                [{ boxShadow: '0 0 0 0 rgba(243,194,24,.6)' }, { boxShadow: '0 0 0 6px rgba(243,194,24,0)' }],
                { duration: 500, easing: 'cubic-bezier(.22,1,.36,1)' });
        });
    }
</script>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string errorMessage = "";
    private string returnUrl = "/";

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Error)) { errorMessage = Error; }
        returnUrl = string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl;
    }
}
