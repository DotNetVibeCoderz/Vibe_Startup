@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthState

<div class="brutal-layout">

    <button class="mobile-menu-btn" style="position:fixed;top:.75rem;left:.75rem;z-index:200;"
            aria-label="@(mobileOpen ? "Tutup menu" : "Buka menu")"
            aria-expanded="@mobileOpen"
            @onclick="ToggleMobile">
        @(mobileOpen ? "✕" : "☰")
    </button>

    @if (mobileOpen)
    {
        <div class="rail-scrim" @onclick="() => mobileOpen = false"></div>
    }

    <aside class="brutal-sidebar @(mobileOpen ? "mobile-open" : "")">
        <div class="brutal-sidebar-logo">
            🏋️ Fitness<br />Center
        </div>

        <nav aria-label="Menu utama">
            <NavLink class="brutal-nav-item" href="/" Match="NavLinkMatch.All" @onclick="CloseMobile">
                <span class="nav-ico">🏠</span> Dashboard
            </NavLink>

            @if (isAuthenticated)
            {
                <div class="nav-section">Operasional</div>
                <NavLink class="brutal-nav-item" href="/members" @onclick="CloseMobile"><span class="nav-ico">👥</span> Members</NavLink>
                <NavLink class="brutal-nav-item" href="/memberships" @onclick="CloseMobile"><span class="nav-ico">💳</span> Memberships</NavLink>
                <NavLink class="brutal-nav-item" href="/attendance" @onclick="CloseMobile"><span class="nav-ico">📋</span> Attendance</NavLink>
                <NavLink class="brutal-nav-item" href="/classes" @onclick="CloseMobile"><span class="nav-ico">📅</span> Classes</NavLink>
                <NavLink class="brutal-nav-item" href="/trainers" @onclick="CloseMobile"><span class="nav-ico">🎯</span> Trainers</NavLink>

                <div class="nav-section">Keuangan</div>
                <NavLink class="brutal-nav-item" href="/payments" @onclick="CloseMobile"><span class="nav-ico">💰</span> Payments</NavLink>
                <NavLink class="brutal-nav-item" href="/discounts" @onclick="CloseMobile"><span class="nav-ico">🏷️</span> Discounts</NavLink>

                <div class="nav-section">Komunitas</div>
                <NavLink class="brutal-nav-item" href="/forum" @onclick="CloseMobile"><span class="nav-ico">💬</span> Forum</NavLink>
                <NavLink class="brutal-nav-item" href="/events" @onclick="CloseMobile"><span class="nav-ico">🎪</span> Events</NavLink>
                <NavLink class="brutal-nav-item" href="/leaderboard" @onclick="CloseMobile"><span class="nav-ico">🏆</span> Leaderboard</NavLink>
                <NavLink class="brutal-nav-item" href="/feedback" @onclick="CloseMobile"><span class="nav-ico">⭐</span> Feedback</NavLink>

                <div class="nav-section">Latihan</div>
                <NavLink class="brutal-nav-item" href="/workout" @onclick="CloseMobile"><span class="nav-ico">🏃</span> Workout</NavLink>
                <NavLink class="brutal-nav-item" href="/nutrition" @onclick="CloseMobile"><span class="nav-ico">🥗</span> Nutrition</NavLink>
                <NavLink class="brutal-nav-item" href="/chatbot" @onclick="CloseMobile"><span class="nav-ico">🤖</span> Coach Tommy</NavLink>

                <div class="nav-section">Akun</div>
                <NavLink class="brutal-nav-item" href="/profile" @onclick="CloseMobile"><span class="nav-ico">👤</span> Profil saya</NavLink>
                <NavLink class="brutal-nav-item" href="/reset-password" @onclick="CloseMobile"><span class="nav-ico">🔑</span> Ubah password</NavLink>

                @if (currentUser?.Role == UserRole.Admin)
                {
                    <div class="nav-section">Admin</div>
                    <NavLink class="brutal-nav-item" href="/admin/config" @onclick="CloseMobile"><span class="nav-ico">⚙️</span> Konfigurasi</NavLink>
                    <a class="brutal-nav-item" href="/api/docs" target="_blank" rel="noopener"><span class="nav-ico">📡</span> API docs ↗</a>
                }
            }
            else
            {
                <div class="nav-section">Akun</div>
                <NavLink class="brutal-nav-item" href="/login" @onclick="CloseMobile"><span class="nav-ico">🔑</span> Masuk</NavLink>
                <NavLink class="brutal-nav-item" href="/register" @onclick="CloseMobile"><span class="nav-ico">📝</span> Daftar</NavLink>
            }
        </nav>

        <div class="brutal-sidebar-footer">
            @if (isAuthenticated && currentUser != null)
            {
                <div class="rail-user">
                    <div class="avatar" aria-hidden="true">
                        @if (!string.IsNullOrEmpty(currentUser.ProfilePictureUrl))
                        {
                            <img src="@currentUser.ProfilePictureUrl" alt="" />
                        }
                        else
                        {
                            @Initials(currentUser.FullName)
                        }
                    </div>
                    <div style="min-width:0;">
                        <div class="rail-user-name" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@currentUser.FullName</div>
                        <div class="rail-user-role">@currentUser.Role · ⭐ @currentUser.LoyaltyPoints</div>
                    </div>
                </div>

                <form action="/logout" method="post">
                    <AntiforgeryToken />
                    <button type="submit" class="brutal-btn brutal-btn-outline brutal-btn-sm brutal-btn-block">Keluar</button>
                </form>
            }
            else
            {
                <a href="/login" class="brutal-btn brutal-btn-sm brutal-btn-block">Masuk</a>
            }
        </div>
    </aside>

    <main class="brutal-main">
        <div class="brutal-topbar">
            <div style="min-width:0;">
                <div class="eyebrow">@GetSectionLabel()</div>
                <h3 style="margin:0;">@GetPageTitle()</h3>
            </div>

            <div class="flex items-center gap-1">
                @if (isAuthenticated)
                {
                    <a href="/notifications" class="brutal-btn brutal-btn-ghost brutal-btn-sm brutal-btn-icon" title="Notifikasi" aria-label="Notifikasi">🔔</a>
                    <a href="/profile" class="brutal-btn brutal-btn-ghost brutal-btn-sm brutal-btn-icon" title="Profil" aria-label="Profil">👤</a>
                }
                <button class="theme-toggle" onclick="toggleTheme()" title="Ganti tema terang/gelap" aria-label="Ganti tema terang atau gelap"></button>
            </div>
        </div>

        @Body
    </main>
</div>

@code {
    private bool mobileOpen;
    private bool isAuthenticated;
    private ApplicationUser? currentUser;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        try
        {
            var authState = await AuthState.GetAuthenticationStateAsync();
            var principal = authState.User;
            isAuthenticated = principal.Identity?.IsAuthenticated ?? false;
            if (isAuthenticated) currentUser = await UserManager.GetUserAsync(principal);
        }
        catch { isAuthenticated = false; }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        mobileOpen = false;
        StateHasChanged();
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private void ToggleMobile() => mobileOpen = !mobileOpen;
    private void CloseMobile() => mobileOpen = false;

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..1].ToUpperInvariant()
            : (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }

    private string CurrentPath =>
        "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].TrimEnd('/').ToLowerInvariant();

    private string GetPageTitle() => CurrentPath switch
    {
        "/" => "Dashboard",
        "/members" => "Members",
        "/memberships" => "Memberships",
        "/attendance" => "Attendance",
        "/classes" => "Classes",
        "/trainers" => "Trainers",
        "/payments" => "Payments",
        "/discounts" => "Discounts",
        "/forum" => "Forum",
        "/events" => "Events",
        "/workout" => "Workout",
        "/nutrition" => "Nutrition",
        "/feedback" => "Feedback",
        "/leaderboard" => "Leaderboard",
        "/chatbot" => "Coach Tommy",
        "/profile" => "Profil saya",
        "/notifications" => "Notifikasi",
        "/reset-password" => "Ubah password",
        "/admin/config" => "Konfigurasi",
        _ => CurrentPath.Trim('/').Replace('-', ' ').Replace('/', ' ')
    };

    private string GetSectionLabel() => CurrentPath switch
    {
        "/" => "Ringkasan hari ini",
        "/members" or "/memberships" or "/attendance" or "/classes" or "/trainers" => "Operasional",
        "/payments" or "/discounts" => "Keuangan",
        "/forum" or "/events" or "/leaderboard" or "/feedback" => "Komunitas",
        "/workout" or "/nutrition" or "/chatbot" => "Latihan",
        "/admin/config" => "Admin",
        _ => "Akun"
    };
}
