@page "/login"
@layout LoginLayout
@inject Services.AuthService AuthService
@inject NavigationManager Nav

@* Login memakai form POST biasa ke /auth/login, bukan @onclick.
   Alasannya: cookie autentikasi HttpOnly hanya bisa ditulis dari response HTTP,
   tidak dari dalam circuit SignalR. AntiforgeryToken melindungi form ini dari CSRF. *@

<div class="login-page">
    <div class="login-card">
        <div style="text-align:center;margin-bottom:16px;">
            <span style="font-size:3rem;">🕌</span>
        </div>
        <h2>HolySafar</h2>
        <p class="subtitle">Sistem Manajemen Travel Haji & Umroh</p>
        <h3 style="margin-bottom:16px;">Masuk ke Akun</h3>

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="alert alert-danger">@Error</div>
        }

        <form method="post" action="/auth/login">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <div class="form-group">
                <label for="username">Username</label>
                <input id="username" name="username" type="text" class="form-control" placeholder="Username" autocomplete="username" required />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input id="password" name="password" type="password" class="form-control" placeholder="Password" autocomplete="current-password" required />
            </div>

            <div style="text-align:right;margin-bottom:16px;">
                <a href="/reset-password" style="font-size:0.85rem;">Lupa password?</a>
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-lg">Masuk</button>
        </form>

        <div style="text-align:center;margin-top:16px;">
            <span>Belum punya akun? </span>
            <a href="/register">Daftar di sini</a>
        </div>

        <div style="text-align:center;margin-top:16px;font-size:0.8rem;color:var(--text-muted);">
            <p><strong>Demo login:</strong></p>
            <p>Admin: <code>admin</code> / <code>admin123</code></p>
            <p>Agen: <code>agen1</code> / <code>agen123</code></p>
            <p>Jamaah: <code>jamaah1</code> / <code>jamaah123</code></p>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")] private string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await AuthService.EnsureAsync();
        if (AuthService.IsAuthenticated) Nav.NavigateTo("/");
    }
}
