    private async Task BackupDatabase()
    {
        _working = true;
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            var (nama, isi) = await Backup.CreateDatabaseSnapshotAsync(user?.Username ?? "admin");
            await JS.InvokeVoidAsync("hsDownload", nama, "application/octet-stream", Convert.ToBase64String(isi));
            _notif = $"Backup {nama} berhasil dibuat dan diunduh."; _notifOk = true;
            await MuatData();
        }
        catch (Exception ex) { _notif = $"Backup gagal: {ex.Message}"; _notifOk = false; }
        finally { _working = false; }
    }

    private async Task ExportSemua()
    {
        _working = true;
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            var (nama, isi) = await Backup.CreateFullExportAsync(user?.Username ?? "admin");
            await JS.InvokeVoidAsync("hsDownload", nama, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(isi));
            _notif = $"Ekspor {nama} selesai."; _notifOk = true;
            await MuatData();
        }
        catch (Exception ex) { _notif = $"Ekspor gagal: {ex.Message}"; _notifOk = false; }
        finally { _working = false; }
    }

    private void BukaAsuransi(Models.Asuransi? a)
    {
        _editAsuransi = a == null ? new Models.Asuransi { IsActive = true } : new Models.Asuransi
        {
            Id = a.Id, NamaProduk = a.NamaProduk, Penyedia = a.Penyedia, Cakupan = a.Cakupan,
            NilaiPertanggungan = a.NilaiPertanggungan, Premi = a.Premi, KontakKlaim = a.KontakKlaim,
            PolisUrl = a.PolisUrl, IsActive = a.IsActive
        };
        _showAsuransiForm = true;
    }

    private async Task SimpanAsuransi()
    {
        if (string.IsNullOrWhiteSpace(_editAsuransi.NamaProduk)) return;
        if (_editAsuransi.Id == 0) Db.Asuransi.Add(_editAsuransi);
        else
        {
            var row = await Db.Asuransi.FindAsync(_editAsuransi.Id);
            if (row == null) return;
            row.NamaProduk = _editAsuransi.NamaProduk; row.Penyedia = _editAsuransi.Penyedia;
            row.Cakupan = _editAsuransi.Cakupan; row.NilaiPertanggungan = _editAsuransi.NilaiPertanggungan;
            row.Premi = _editAsuransi.Premi; row.KontakKlaim = _editAsuransi.KontakKlaim;
            row.PolisUrl = _editAsuransi.PolisUrl; row.IsActive = _editAsuransi.IsActive;
        }
        await Db.SaveChangesAsync();
        _showAsuransiForm = false;
        _notif = "Data asuransi tersimpan."; _notifOk = true;
        await MuatData();
    }

    private async Task HapusAsuransi(Models.Asuransi a)
    {
        Db.Asuransi.Remove(a);
        await Db.SaveChangesAsync();
        await MuatData();
        _notif = "Produk asuransi dihapus."; _notifOk = true;
    }
}
