@inherits LayoutComponentBase
@inject Services.AuthService AuthService
@inject Services.NotifikasiService NotifService
@inject Services.LocalizationService L
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<div class="holysafar-app @_themeClass">
    <!-- Mobile overlay -->
    <div class="sidebar-mobile-overlay @(_mobileOpen ? "show" : "")" @onclick="CloseMobileSidebar"></div>

    <aside class="sidebar @(_sidebarCollapsed ? "collapsed" : "") @(_mobileOpen ? "mobile-open" : "")">
        <div class="sidebar-header">
            <a href="/" class="brand"><span class="brand-icon">🕌</span>@if (!_sidebarCollapsed || _mobileOpen) { <span class="brand-text">HolySafar</span> }</a>
            <button class="btn-toggle-sidebar" @onclick="ToggleSidebar"><i class="bi bi-list"></i></button>
        </div>
        <nav class="sidebar-nav" @onclick="() => { if (_mobileOpen) CloseMobileSidebar(); }">
            <NavLink href="/" Match="NavLinkMatch.All"><i class="bi bi-house-door"></i>@Lbl(L["nav.beranda"])</NavLink>
            @if (_isAuth)
            {
                @if (_role == "Admin")
                {
                    <div class="nav-section">@L["nav.masterAdmin"]</div>
                    <NavLink href="/admin/users"><i class="bi bi-people"></i>@Lbl(L["nav.user"])</NavLink>
                    <NavLink href="/admin/jamaah"><i class="bi bi-person-vcard"></i>@Lbl(L["nav.jamaah"])</NavLink>
                    <NavLink href="/admin/paket"><i class="bi bi-box"></i>@Lbl(L["nav.paket"])</NavLink>
                    <NavLink href="/admin/itinerary"><i class="bi bi-signpost-split"></i>@Lbl(L["nav.itinerary"])</NavLink>
                    <NavLink href="/admin/produk"><i class="bi bi-bag"></i>@Lbl(L["nav.produk"])</NavLink>
                    <NavLink href="/admin/pembayaran"><i class="bi bi-cash-coin"></i>@Lbl(L["nav.pembayaran"])</NavLink>
                    <NavLink href="/admin/keberangkatan"><i class="bi bi-airplane"></i>@Lbl(L["nav.keberangkatan"])</NavLink>
                    <NavLink href="/admin/materi-manasik"><i class="bi bi-journal-text"></i>@Lbl(L["nav.materi"])</NavLink>
                    <NavLink href="/admin/kuis"><i class="bi bi-patch-question"></i>@Lbl(L["nav.kuis"])</NavLink>
                    <NavLink href="/admin/pengumuman"><i class="bi bi-megaphone"></i>@Lbl(L["nav.pengumuman"])</NavLink>
                    <div class="nav-section">@L["nav.monitoring"]</div>
                    <NavLink href="/admin/operasional"><i class="bi bi-speedometer2"></i>@Lbl(L["nav.operasional"])</NavLink>
                    <NavLink href="/admin/laporan"><i class="bi bi-graph-up"></i>@Lbl(L["nav.laporan"])</NavLink>
                    <NavLink href="/admin/transaksi"><i class="bi bi-credit-card-2-front"></i>@Lbl(L["nav.transaksi"])</NavLink>
                    <NavLink href="/admin/sos"><i class="bi bi-exclamation-triangle"></i>@Lbl(L["nav.sosPanel"])</NavLink>
                    <NavLink href="/admin/orders"><i class="bi bi-cart-check"></i>@Lbl(L["nav.orders"])</NavLink>
                    <NavLink href="/admin/pengaturan"><i class="bi bi-gear"></i>@Lbl(L["nav.pengaturan"])</NavLink>
                }
                @if (_role == "Agen" || _role == "Admin")
                {
                    <div class="nav-section">@L["nav.agen"]</div>
                    <NavLink href="/agen/paket"><i class="bi bi-box"></i>@Lbl(L["nav.kelolaPaket"])</NavLink>
                    <NavLink href="/agen/jamaah"><i class="bi bi-people"></i>@Lbl(L["nav.jamaahSaya"])</NavLink>
                    <NavLink href="/admin/dokumen"><i class="bi bi-folder-check"></i>@Lbl(L["nav.dokumen"])</NavLink>
                }
                <div class="nav-section">@L["nav.menu"]</div>
                <NavLink href="/paket"><i class="bi bi-tag"></i>@Lbl(L["nav.paket"])</NavLink>
                <NavLink href="/tracking"><i class="bi bi-clipboard-check"></i>@Lbl(L["nav.tracking"])</NavLink>
                <NavLink href="/dokumen"><i class="bi bi-file-earmark-arrow-up"></i>@Lbl(L["nav.dokumenSaya"])</NavLink>
                <NavLink href="/pembayaran"><i class="bi bi-wallet2"></i>@Lbl(L["nav.tagihan"])</NavLink>
                <NavLink href="/perjalanan"><i class="bi bi-map"></i>@Lbl(L["nav.perjalanan"])</NavLink>
                <NavLink href="/marketplace"><i class="bi bi-shop"></i>@Lbl(L["nav.marketplace"])</NavLink>
                <NavLink href="/edukasi"><i class="bi bi-book"></i>@Lbl(L["nav.edukasi"])</NavLink>
                <NavLink href="/chatbot"><i class="bi bi-robot"></i>@Lbl(L["nav.chatbot"])</NavLink>
                <NavLink href="/tracker"><i class="bi bi-crosshair"></i>@Lbl(L["nav.gpsTracker"])</NavLink>
                <NavLink href="/gps"><i class="bi bi-geo-alt"></i>@Lbl(L["nav.gpsAdmin"])</NavLink>
                <NavLink href="/sos"><i class="bi bi-exclamation-circle"></i>@Lbl(L["nav.sos"])</NavLink>
                <NavLink href="/forum"><i class="bi bi-chat-square-text"></i>@Lbl(L["nav.forum"])</NavLink>
                <NavLink href="/pengumuman"><i class="bi bi-megaphone"></i>@Lbl(L["nav.pengumuman"])</NavLink>
                <NavLink href="/chat"><i class="bi bi-chat-dots"></i>@Lbl(L["nav.pesan"])</NavLink>
            }
        </nav>
    </aside>

    <main class="main-content">
        <header class="topbar">
            <div class="topbar-left">
                <button class="mobile-menu-btn" @onclick="ToggleMobileSidebar" aria-label="Menu">
                    <i class="bi bi-list"></i>
                </button>
                <h2 class="page-title">@_pageTitle</h2>
            </div>
            <div class="topbar-right">
                <a class="btn-icon" href="@CultureUrl()" title="@L["ui.bahasa"]" style="font-size:0.75rem;font-weight:700;text-decoration:none;">@L.CurrentLanguageLabel</a>
                <button class="btn-icon" @onclick="ToggleTheme" title="@L["ui.tema"]"><i class="bi bi-@(_isDark ? "sun" : "moon")"></i></button>
                @if (_isAuth)
                {
                    <button class="btn-icon position-relative" @onclick="GoNotif"><i class="bi bi-bell"></i>
                        @if (_unreadNotif > 0) { <span class="badge-notif">@_unreadNotif</span> }
                    </button>
                    <div class="user-dropdown" style="position:relative;">
                        <button class="btn-user" @onclick="ToggleUserMenu">
                            <span class="user-avatar">@(_cUser?.FullName?.FirstOrDefault() ?? '?')</span>
                            <span class="user-name">@_cUser?.FullName</span>
                            <i class="bi bi-chevron-down" style="font-size:0.7rem;"></i>
                        </button>
                        @if (_showUserMenu)
                        {
                            <div class="dropdown-menu show" style="position:absolute;top:100%;right:0;z-index:9999;pointer-events:auto;">
                                <div style="padding:8px 12px;"><strong>@_cUser?.FullName</strong><br><small class="text-muted">@_cUser?.Role</small></div>
                                <hr>
                                <a href="/profile" class="dropdown-item" @onclick="() => _showUserMenu = false"><i class="bi bi-person"></i> @L["ui.profil"]</a>
                                <!-- Logout wajib POST ber-antiforgery: cookie auth hanya bisa dihapus server-side -->
                                <form method="post" action="/auth/logout" style="margin:0;">
                                    <AntiforgeryToken />
                                    <button type="submit" class="dropdown-item" style="width:100%;text-align:left;"><i class="bi bi-box-arrow-right"></i> @L["ui.logout"]</button>
                                </form>
                            </div>
                        }
                    </div>
                }
                else { <a href="/login" class="btn btn-primary btn-sm">@L["ui.login"]</a> }
            </div>
        </header>
        <div class="page-content">@Body</div>
    </main>
</div>

@code {
    private bool _sidebarCollapsed, _isDark, _showUserMenu, _isAuth, _mobileOpen;
    private int _unreadNotif; private string _pageTitle = "Dashboard", _themeClass = "theme-light", _role = "";
    private HolySafar.Models.ApplicationUser? _cUser;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.EnsureAsync();
        _cUser = await AuthService.GetCurrentUserAsync(); _isAuth = _cUser != null; _role = AuthService.CurrentUserRole;
        await LoadNotif(); Nav.LocationChanged += OnLocChanged;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) { await LoadNotif(); StateHasChanged(); } }
    private async Task LoadNotif() { try { if (AuthService.CurrentUserId is int uid) _unreadNotif = await NotifService.GetUnreadCountAsync(uid); } catch { } }
    private void OnLocChanged(object? s, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) { _showUserMenu = false; _mobileOpen = false; StateHasChanged(); }
    private RenderFragment Lbl(string text) => builder => { if (!_sidebarCollapsed || _mobileOpen) { builder.OpenElement(0, "span"); builder.AddContent(1, text); builder.CloseElement(); } };
    private string CultureUrl() => $"/set-culture?culture={(L.CurrentLanguage == "id" ? "en" : "id")}&redirectUri={Uri.EscapeDataString(new Uri(Nav.Uri).PathAndQuery)}";
    private void ToggleSidebar() => _sidebarCollapsed = !_sidebarCollapsed;
    private void ToggleUserMenu() => _showUserMenu = !_showUserMenu;
    private void ToggleTheme() { _isDark = !_isDark; _themeClass = _isDark ? "theme-dark" : "theme-light"; }
    private void GoNotif() => Nav.NavigateTo("/notifikasi");
    private void ToggleMobileSidebar() => _mobileOpen = !_mobileOpen;
    private void CloseMobileSidebar() => _mobileOpen = false;
    public void Dispose() => Nav.LocationChanged -= OnLocChanged;
}
