@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@page "/auth/login"
@inject NavigationManager Nav

<PageTitle>Masuk - PadelHub</PageTitle>

<div class="d-flex justify-center" style="padding-block:1rem;">
    <div class="pd-card pd-enter" style="max-width:940px; width:100%; overflow:hidden;">
        <div style="display:grid; grid-template-columns:minmax(0,.85fr) minmax(0,1fr);" class="pd-login-grid">

            @* --- Panel lapangan --- *@
            <div style="background:radial-gradient(120% 130% at 20% 0%, #12454E, #08262C 62%, #041a1f); color:#fff; padding:2.25rem 2rem; display:flex; flex-direction:column; justify-content:space-between; gap:2rem;">
                <div>
                    <div class="pd-hero__eyebrow" style="margin-bottom:.85rem;">Selamat datang kembali</div>
                    <div style="font-family:'Archivo',sans-serif; font-weight:800; font-size:1.65rem; letter-spacing:-.03em; line-height:1.1;">
                        Lapangan sudah siap.
                    </div>
                    <p style="color:rgba(255,255,255,.65); font-size:.875rem; line-height:1.6; margin:.75rem 0 0;">
                        Masuk untuk mengatur reservasi, turnamen, dan pembayaran klub.
                    </p>
                </div>

                <CourtGraphic />
            </div>

            @* --- Formulir --- *@
            <div class="pa-8">
                <h1 class="pd-page-title" style="font-size:1.5rem;" tabindex="-1">Masuk</h1>
                <p class="pd-page-sub" style="margin-bottom:1.5rem;">Gunakan email yang terdaftar di klub Anda.</p>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Outlined" Dense="true">@_error</MudAlert>
                }

                <!--
                    Gunakan form post biasa agar cookie login bisa diset oleh server
                    (menghindari error "Headers are read-only, response has already started").
                -->
                <form method="post" action="/auth/login-handler">
                    <MudTextField @bind-Value="_model.Email" Name="Email" Label="Email" Variant="Variant.Outlined"
                                  Required="true" InputType="InputType.Email"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.AlternateEmail" Class="mb-3" />

                    <MudTextField @bind-Value="_model.Password" Name="Password" Label="Password" Variant="Variant.Outlined"
                                  Required="true" InputType="InputType.Password"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Lock" Class="mb-1" />

                    <div class="d-flex justify-space-between align-center mb-4">
                        <MudCheckBox @bind-Value="_model.RememberMe" Name="RememberMe" Label="Ingat saya" Size="Size.Small" Color="Color.Primary" />
                        <a href="/auth/reset-password" style="color:var(--mud-palette-primary); font-size:.8125rem; text-decoration:none;">Lupa password?</a>
                    </div>

                    <input type="hidden" name="ReturnUrl" value="@returnUrl" />

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                               ButtonType="ButtonType.Submit" StartIcon="@Icons.Material.Rounded.Login">Masuk</MudButton>
                </form>

                <p style="text-align:center; font-size:.875rem; margin:1.25rem 0 0; color:var(--mud-palette-text-secondary);">
                    Belum punya akun?
                    <a href="/auth/register" style="color:var(--mud-palette-primary); font-weight:600; text-decoration:none;">Daftar sekarang</a>
                </p>

                <hr class="pd-rule" style="margin:1.5rem 0 1rem;" />

                <div class="pd-eyebrow" style="margin-bottom:.6rem;">Akun demo</div>
                <p style="font-size:.8125rem; color:var(--mud-palette-text-secondary); margin:0 0 .75rem;">
                    Pilih peran untuk mengisi formulir secara otomatis.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var demo in _demoAccounts)
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Default"
                                   OnClick="() => Fill(demo)">@demo.Role</MudButton>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media (max-width: 800px) {
        .pd-login-grid {
            grid-template-columns: 1fr !important;
        }
    }
</style>

@code {
    private LoginModel _model = new();

    [SupplyParameterFromQuery] private string? returnUrl { get; set; }
    [SupplyParameterFromQuery] private string? error { get; set; }

    private string? _error => error;

    private readonly DemoAccount[] _demoAccounts =
    [
        new("Admin", "admin@padelhub.com", "Admin@123"),
        new("Operator", "operator@padelhub.com", "Operator@123"),
        new("Pelatih", "coach.andi@padelhub.com", "Coach@123"),
        new("Member", "rina@padelhub.com", "Member@123"),
    ];

    private void Fill(DemoAccount account)
    {
        _model.Email = account.Email;
        _model.Password = account.Password;
    }

    private record DemoAccount(string Role, string Email, string Password);

    private class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public bool RememberMe { get; set; }
    }
}
